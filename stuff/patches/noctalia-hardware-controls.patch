+  std::string generateCvtModeline(int h, int v, float hz) {
+    int vsync = 10;
+    if (v % 3 == 0 && v * 4 / 3 == h) vsync = 4;
+    else if (v % 9 == 0 && (v * 16 / 9 == h || v * 15 / 9 == h)) vsync = (v * 16 / 9 == h ? 5 : 7);
+    else if (v % 10 == 0 && v * 16 / 10 == h) vsync = 6;
+    else if (v % 4 == 0 && v * 5 / 4 == h) vsync = 7;
+
+    double hperiod = (1000000.0 / hz - 550.0) / (v + 3);
+    int vsync_bp = std::max(static_cast<int>(550.0 / hperiod) + 1, vsync + 6);
+    double hblank_pct = std::max(20.0, 30.0 - 300.0 * hperiod / 1000.0);
+    int hblank = (static_cast<int>(h * hblank_pct / (100.0 - hblank_pct)) / 16) * 16;
+    int htotal = h + hblank;
+    int hsync_end = h + hblank / 2;
+    int hsync_w = ((htotal * 8) / 100 / 8) * 8;
+    int pclk_khz = (static_cast<int>(htotal * 1000.0 / hperiod) / 250) * 250;
+
+    return std::format(
+        "modeline {:.2F} {} {} {} {} {} {} {} {} -hsync +vsync",
+        pclk_khz / 1000.0, h, hsync_end - hsync_w, hsync_end, htotal,
+        v, v + 3, v + 3 + vsync, v + vsync_bp + 3
+    );
+  }
