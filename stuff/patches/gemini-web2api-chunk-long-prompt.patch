 // MaxPromptLength 是官网输入框在高级模式下的字符上限，上游对更长的提示词不返回候选
 const MaxPromptLength = 1_000_000
 
-// LongPromptInstruction 是超长提示词改为 message.txt 附件后生成请求中的提示词
-const LongPromptInstruction = "The complete input for this turn is in the attached message.txt. Treat its content as the user's message and respond to it directly."
+// inlinePromptTargetRunes 是超长提示词保留在内联输入框中的尾部字符上限，为说明与边界标记留出余量
+const inlinePromptTargetRunes = 950_000
+
+// maxAttachmentChunkBytes 是单个 text/plain 附件分片的字节上限，低于 Gemini Web 非 Task 模式的 384 KiB 截断阈值
+const maxAttachmentChunkBytes = 350 * 1024
+
+// splitLongPrompt 把超过 MaxPromptLength 的提示词拆分为多个 <= 350 KiB 的 text/plain 附件前缀 + 保留在内联输入框的尾部，
+// 并为每个分片加上明确的起止与完整结束标记，便于模型检测是否发生截断。
+func splitLongPrompt(prompt string) (string, []FileData) {
+	totalBytes := len(prompt)
+
+	splitIdx := totalBytes
+	runes := 0
+	for splitIdx > 0 && runes < inlinePromptTargetRunes {
+		_, size := utf8.DecodeLastRuneInString(prompt[:splitIdx])
+		splitIdx -= size
+		runes++
+	}
+	if splitIdx > 0 && splitIdx < totalBytes {
+		searchEnd := min(totalBytes, splitIdx+4096)
+		if nl := strings.IndexByte(prompt[splitIdx:searchEnd], '\n'); nl >= 0 {
+			splitIdx += nl + 1
+		}
+	}
+
+	prefix := prompt[:splitIdx]
+	tail := prompt[splitIdx:]
+
+	var rawChunks []string
+	for start := 0; start < len(prefix); {
+		end := min(len(prefix), start+maxAttachmentChunkBytes)
+		if end < len(prefix) {
+			for end > start && !utf8.RuneStart(prefix[end]) {
+				end--
+			}
+			searchStart := max(start, end-4096)
+			if nl := strings.LastIndexByte(prefix[searchStart:end], '\n'); nl >= 0 {
+				end = searchStart + nl + 1
+			}
+			if end == start {
+				_, size := utf8.DecodeRuneInString(prefix[start:])
+				end = start + size
+			}
+		}
+		rawChunks = append(rawChunks, prefix[start:end])
+		start = end
+	}
+
+	totalParts := len(rawChunks) + 1
+	files := make([]FileData, 0, len(rawChunks))
+	offset := 0
+	for i, chunk := range rawChunks {
+		partNum := i + 1
+		startOff := offset
+		endOff := offset + len(chunk)
+		offset = endOff
+
+		var b strings.Builder
+		b.Grow(len(chunk) + 128)
+		fmt.Fprintf(&b, "=== BEGIN MESSAGE PART %d/%d (bytes %d..%d of %d) ===\n", partNum, totalParts, startOff, endOff, totalBytes)
+		b.WriteString(chunk)
+		if !strings.HasSuffix(chunk, "\n") {
+			b.WriteByte('\n')
+		}
+		fmt.Fprintf(&b, "=== END MESSAGE PART %d/%d ===\n", partNum, totalParts)
+
+		files = append(files, FileData{
+			Data:     []byte(b.String()),
+			FileName: fmt.Sprintf("message_part_%d_of_%d.txt", partNum, totalParts),
+			MimeType: "text/plain",
+		})
+	}
+
+	partList := fmt.Sprintf("attached file message_part_1_of_%d.txt", totalParts)
+	if len(rawChunks) > 1 {
+		partList = fmt.Sprintf("attached files message_part_1_of_%d.txt through message_part_%d_of_%d.txt", totalParts, len(rawChunks), totalParts)
+	}
+
+	var inline strings.Builder
+	inline.Grow(len(tail) + 1024)
+	fmt.Fprintf(&inline,
+		"The complete input for this turn (%d bytes) is split sequentially into %d parts: %s, followed by part %d/%d inline below. "+
+			"Treat all %d parts concatenated in order as the complete user message and respond to it directly. "+
+			"Every part is framed by \"=== BEGIN MESSAGE PART i/%d ... ===\" and \"=== END MESSAGE PART i/%d ===\", and the final part ends with \"=== END OF COMPLETE INPUT (%d/%d parts, %d bytes) ===\". "+
+			"If any part's END marker or the final END OF COMPLETE INPUT marker is missing, the input was truncated—explicitly report which part(s) were truncated instead of guessing.\n\n",
+		totalBytes, totalParts, partList, totalParts, totalParts,
+		totalParts, totalParts, totalParts, totalParts, totalParts, totalBytes,
+	)
+	fmt.Fprintf(&inline, "=== BEGIN MESSAGE PART %d/%d (INLINE, bytes %d..%d of %d) ===\n", totalParts, totalParts, offset, totalBytes, totalBytes)
+	inline.WriteString(tail)
+	if !strings.HasSuffix(tail, "\n") {
+		inline.WriteByte('\n')
+	}
+	fmt.Fprintf(&inline, "=== END MESSAGE PART %d/%d ===\n=== END OF COMPLETE INPUT (%d/%d parts, %d bytes) ===\n", totalParts, totalParts, totalParts, totalParts, totalBytes)
+
+	return inline.String(), files
+}
 
