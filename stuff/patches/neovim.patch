+bool terminal_line_is_continuation(buf_T *buf, int linenr)
+{
+  if (!buf || !buf->terminal) {
+    return false;
+  }
+  Terminal *term = buf->terminal;
+  int row = linenr_to_row(term, linenr);
+  if (row < 0) {
+    int idx = -row - 1;
+    if (idx >= 0 && (size_t)idx < term->sb_current) {
+      return term->sb_buffer[idx]->continuation;
+    }
+  } else {
+    VTermState *state = vterm_obtain_state(term->vt);
+    const VTermLineInfo *info = vterm_state_get_lineinfo(state, row);
+    if (info) {
+      return info->continuation;
+    }
+  }
+  return false;
+}
