@@ -54,3 +56,12 @@ fn is_proc_alive(pid: Pid) -> bool {
         Err(_) => false,
     }
 }
+
+fn is_noctalia(pid: Pid) -> bool {
+    std::fs::read_link(format!("/proc/{pid}/exe")).is_ok_and(|exe| {
+        matches!(
+            exe.file_name().and_then(std::ffi::OsStr::to_str),
+            Some("noctalia" | ".noctalia-wrapped")
+        )
+    })
+}
