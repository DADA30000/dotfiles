+static gboolean
+valent_wayland_source_prepare (GSource *source, int *timeout)
+{
+  ValentWaylandSource *wsource = (ValentWaylandSource *)source;
+  *timeout = -1;
+  while (wl_display_prepare_read (wsource->display) != 0)
+    wl_display_dispatch_pending (wsource->display);
+  wsource->reading = TRUE;
+  wl_display_flush (wsource->display);
+  return FALSE;
+}
+
+static gboolean
+valent_wayland_source_check (GSource *source)
+{
+  ValentWaylandSource *wsource = (ValentWaylandSource *)source;
+  if (wsource->reading)
+    {
+      wsource->reading = FALSE;
+      if (wsource->pfd.revents & G_IO_IN)
+        {
+          wl_display_read_events (wsource->display);
+          return TRUE;
+        }
+      else
+        {
+          wl_display_cancel_read (wsource->display);
+        }
+    }
+  return FALSE;
+}
+
+static gboolean
+valent_wayland_source_dispatch (GSource *source, GSourceFunc callback, gpointer user_data)
+{
+  ValentWaylandSource *wsource = (ValentWaylandSource *)source;
+  wl_display_dispatch_pending (wsource->display);
+  return G_SOURCE_CONTINUE;
+}
