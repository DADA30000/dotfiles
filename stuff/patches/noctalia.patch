+          std::string vramStr;
+          if (vUsed.has_value() && vTot.has_value()) {
+            try {
+              double uG = std::stod(StringUtils::trim(*vUsed)) / (1024.0 * 1024.0 * 1024.0);
+              double tG = std::stod(StringUtils::trim(*vTot)) / (1024.0 * 1024.0 * 1024.0);
+              vramStr = std::format(" · {:.1F}/{:.1F} GiB", uG, tG);
+            } catch (...) {}
+          }
+          resultStatus = std::format("{:.0F}%{}", u, vramStr);
+        }
+      }
+      if (!resultStatus.empty()) {
+        std::lock_guard<std::mutex> lock(s_gpu1Mutex);
+        s_cachedGpu1Status = std::move(resultStatus);
+      }
+      s_gpu1QueryRunning = false;
+    }).detach();
