diff --git a/src/app.rs b/src/app.rs
index 9721679..e22a3af 100644
--- a/src/app.rs
+++ b/src/app.rs
@@ -34,7 +34,9 @@ impl AppState {
             .open_clients()?
             .into_iter()
             .filter(|c| {
-                c.pid().as_raw().cast_unsigned() != std::process::id() && c.pid().as_raw() > 0
+                c.pid().as_raw().cast_unsigned() != std::process::id()
+                    && c.pid().as_raw() > 0
