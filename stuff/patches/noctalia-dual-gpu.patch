+void SystemTab::applyGpuGraphSeries() {
+  if (m_gpuGraph == nullptr || m_monitor == nullptr || !m_monitor->isRunning()) {
+    return;
+  }
+  const auto hist = m_monitor->history();
+  if (hist.size() < 4) {
+    return;
+  }
+  const std::size_t n = hist.size();
+
+  if (m_selectedGpu == 0) {
+    bool hasGpuUsage = false;
+    bool hasGpuTemp = false;
+    bool hasGpuVram = false;
+    std::vector<float> gpuUsage(n);
+    std::vector<float> gpuVram(n);
+    std::vector<float> gpuTemp(n);
+    for (std::size_t i = 0; i < n; ++i) {
+      const auto& s = hist[i];
+      if (s.gpuUsagePercent.has_value()) {
+        hasGpuUsage = true;
+        gpuUsage[i] = static_cast<float>(std::clamp(*s.gpuUsagePercent / 100.0, 0.0, 1.0));
+      }
+      if (s.gpuVramUsedBytes.has_value() && s.gpuVramTotalBytes.has_value() && *s.gpuVramTotalBytes > 0) {
+        hasGpuVram = true;
+        gpuVram[i] = static_cast<float>(
+            std::clamp(static_cast<double>(*s.gpuVramUsedBytes) / static_cast<double>(*s.gpuVramTotalBytes), 0.0, 1.0)
+        );
+      }
+      if (s.gpuTempC.has_value()) {
+        hasGpuTemp = true;
+        const double t = *s.gpuTempC;
+        m_gpuTempMin = std::min(m_gpuTempMin, t);
+        m_gpuTempMax = std::max(m_gpuTempMax, t);
+        const double range = m_gpuTempMax - m_gpuTempMin;
+        gpuTemp[i] = range > 0.0 ? static_cast<float>(std::clamp((t - m_gpuTempMin) / range, 0.0, 1.0)) : 0.5F;
+      }
+    }
+    m_gpuGraph->setValues(hasGpuUsage ? std::move(gpuUsage) : std::vector<float>{});
+    m_gpuGraph->setValues2(hasGpuVram ? std::move(gpuVram) : std::vector<float>{});
+    m_gpuGraph->setValues3(hasGpuTemp ? std::move(gpuTemp) : std::vector<float>{});
+    const bool hasGpuData = hasGpuUsage || hasGpuVram || hasGpuTemp;
+    if (hasGpuData != m_gpuVisible) {
+      m_gpuVisible = hasGpuData;
+      updateGpuVisibility();
+    }
+  } else {
+    auto& nvSvc = noctalia::system::NvidiaGpuService::instance();
+    const auto nv = nvSvc.status();
+    if (nv.suspended || nv.blocked) {
+      m_gpuGraph->setValues(std::vector<float>(n, 0.0F));
+      m_gpuGraph->setValues2({});
+      m_gpuGraph->setValues3({});
+    } else {
+      const auto nvHist = nvSvc.history();
+      const float fallbackUsage = static_cast<float>(std::clamp(nv.usagePct / 100.0, 0.0, 1.0));
+      const float fallbackVram = nv.vramTotalMib > 0.0 ? static_cast<float>(std::clamp(nv.vramUsedMib / nv.vramTotalMib, 0.0, 1.0)) : 0.0F;
+      const float fallbackTemp = static_cast<float>(std::clamp((nv.tempC - 30.0) / 60.0, 0.0, 1.0));
+      std::vector<float> uVec(n, nvHist.empty() ? fallbackUsage : nvHist.front().usage);
+      std::vector<float> vVec(n, nvHist.empty() ? fallbackVram : nvHist.front().vram);
+      std::vector<float> tVec(n, nvHist.empty() ? fallbackTemp : nvHist.front().temp);
+      if (!nvHist.empty()) {
+        const std::size_t take = std::min(n, nvHist.size());
+        const std::size_t srcStart = nvHist.size() - take;
+        const std::size_t dstStart = n - take;
+        for (std::size_t i = 0; i < take; ++i) {
+          uVec[dstStart + i] = nvHist[srcStart + i].usage;
+          vVec[dstStart + i] = nvHist[srcStart + i].vram;
+          tVec[dstStart + i] = nvHist[srcStart + i].temp;
+        }
+      }
+      m_gpuGraph->setValues(std::move(uVec));
+      m_gpuGraph->setValues2(std::move(vVec));
+      m_gpuGraph->setValues3(std::move(tVec));
+    }
+    if (!m_gpuVisible) {
+      m_gpuVisible = true;
+      updateGpuVisibility();
+    }
+  }
+}
