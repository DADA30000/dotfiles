+def _robust_extract_arguments(json_str: str) -> Dict[str, Any]:
+    """Parse JSON arguments tolerating unescaped quotes and dangling keys."""
+    json_str = re.sub(r"<ctrl\d+>", "", json_str).strip()
+    try:
+        return json.loads(json_str)
+    except Exception:
+        pass
+
+    cleaned = re.sub(r",\s*([}\]])", r"\1", json_str)
+    cleaned = re.sub(r",\s*\"[^\"]*\"\s*:\s*(?:[}\]]|$)", r"}", cleaned)
+    try:
+        return json.loads(cleaned)
+    except Exception:
+        pass
+
+    res: Dict[str, Any] = {}
+    cmd_match = re.search(r"\"command\"\s*:\s*\"(.*)", json_str, re.DOTALL)
+    if cmd_match:
+        cmd_rest = cmd_match.group(1)
+        greedy_match = re.search(
+            r"^([\s\S]*)\"\s*(?:,\s*\"[^\"]+\"\s*:|\}\s*$|$)", cmd_rest
+        )
+        if greedy_match:
+            res["command"] = greedy_match.group(1)
+        else:
+            end_match = re.search(r"([\s\S]*?)\"\s*(?:,\s*\"|\}|$)", cmd_rest)
+            if end_match:
+                res["command"] = end_match.group(1)
+            else:
+                res["command"] = cmd_rest.rstrip(" \t\n\r\"}")
+
+    for m in re.finditer(r'"(\w+)"\s*:\s*', json_str):
+        k = m.group(1)
+        if k in res:
+            continue
+        v_rest = json_str[m.end() :].lstrip()
+        if v_rest.startswith('"'):
+            vm = re.search(r'^"(.*?)"(?:\s*,|\s*\}|$)', v_rest, re.DOTALL)
+            if vm:
+                res[k] = vm.group(1)
+        else:
+            vm = re.match(r"([^\s,}]+)", v_rest)
+            if vm:
+                val = vm.group(1)
+                if val == "true":
+                    res[k] = True
+                elif val == "false":
+                    res[k] = False
+                elif val == "null":
+                    res[k] = None
+                else:
+                    try:
+                        res[k] = int(val)
+                    except ValueError:
+                        try:
+                            res[k] = float(val)
+                        except ValueError:
+                            pass
+    return res
