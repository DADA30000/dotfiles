+
+  void refreshGpu1StatusAsync() {
+    const auto sec = detectSecondaryGpu();
+    if (!sec.present) {
+      return;
+    }
+
+    const auto now = std::chrono::steady_clock::now();
+    if (now - s_lastGpu1Query < std::chrono::seconds(2)) {
+      return;
+    }
+    s_lastGpu1Query = now;
+    if (s_gpu1QueryRunning.exchange(true)) {
+      return;
+    }
+
+    std::thread([sec]() {
+      auto status = FileUtils::readSmallTextFile(sec.pciPath + "/power/runtime_status");
+      if (!status.has_value() || StringUtils::trim(*status) != "active") {
+        {
+          std::lock_guard<std::mutex> lock(s_gpu1Mutex);
+          s_cachedGpu1Status = "D3cold";
+        }
+        s_gpu1QueryRunning = false;
