+std::unique_ptr<Flex> VpnTab::create() {
+  const float scale = contentScale();
+  auto tab = ui::column({.out = &m_root, .align = FlexAlign::Stretch, .gap = Style::spaceMd * scale});
+
+  auto scroll = ui::scrollView({
+      .scrollbarVisible = true, .flexGrow = 1.0F,
+      .configure = [](ScrollView& s) { s.clearFill(); s.clearBorder(); },
+  });
+
+  auto* content = scroll->content();
+  content->setDirection(FlexDirection::Vertical);
+  content->setAlign(FlexAlign::Stretch);
+  content->setGap(Style::spaceMd * scale);
+
+  // 1. Status Card
+  auto statusCard = ui::column({
+      .configure = [scale, opacity = panelCardOpacity()](Flex& s) { applySectionCardStyle(s, scale, opacity); },
+  });
+  m_statusCard = statusCard.get();
+
+  statusCard->addChild(ui::row(
+      {.align = FlexAlign::Center, .gap = Style::spaceSm * scale, .minHeight = Style::controlHeightSm * scale},
+      ui::glyph({.glyph = "shield-check", .glyphSize = Style::fontSizeTitle * scale, .color = colorSpecFromRole(ColorRole::Primary)}),
+      ui::label({.text = "Активный узел:", .fontSize = Style::fontSizeBody * scale, .color = colorSpecFromRole(ColorRole::OnSurfaceVariant)}),
+      ui::label({
+          .out = &m_activeProxyLabel, .text = "Загрузка...", .fontSize = Style::fontSizeBody * scale,
+          .fontWeight = FontWeight::Bold, .color = colorSpecFromRole(ColorRole::Primary), .flexGrow = 1.0F
+      })
+  ));
+
+  statusCard->addChild(ui::row(
+      {.align = FlexAlign::Center, .gap = Style::spaceSm * scale, .minHeight = Style::controlHeightSm * scale},
+      ui::column(
+          {.align = FlexAlign::Stretch, .flexGrow = 1.0F},
+          ui::label({.text = "Весь остальной трафик", .fontSize = Style::fontSizeBody * scale, .fontWeight = FontWeight::Bold, .color = colorSpecFromRole(ColorRole::OnSurface)}),
+          ui::label({.out = &m_finalStateLabel, .text = "Режим: proxy", .fontSize = Style::fontSizeCaption * scale, .color = colorSpecFromRole(ColorRole::OnSurfaceVariant)})
+      ),
+      ui::toggle({
+          .out = &m_finalToggle, .checkedImmediate = true, .toggleSize = ToggleSize::Medium, .scale = scale,
+          .onChange = [this](bool chk) { setFinalRoute(chk); },
+      })
+  ));
+  content->addChild(std::move(statusCard));
+
+  // 2. Nodes Card
+  auto nodesCard = ui::column({
+      .configure = [scale, opacity = panelCardOpacity()](Flex& s) { applySectionCardStyle(s, scale, opacity); },
+  });
+  m_nodesCard = nodesCard.get();
+  nodesCard->addChild(ui::column({.out = &m_nodesList, .align = FlexAlign::Stretch, .gap = Style::spaceSm * scale}));
+
+  nodesCard->addChild(ui::row(
+      {.align = FlexAlign::Center, .justify = FlexJustify::End},
+      ui::button({
+          .out = &m_testButton, .text = i18n::tr("control-center.vpn.ping"), .variant = ButtonVariant::Default,
+          .paddingV = Style::spaceXs * 0.8F * scale, .paddingH = Style::spaceMd * scale, .radius = 999.0F,
+          .onClick = [this]() { testAllLatencies(); },
+      })
+  ));
+  content->addChild(std::move(nodesCard));
+
+  m_root->addChild(std::move(scroll));
+  fetchProxies();
+  return tab;
+}
