@@ -1,3 +1,19 @@
+function(protobuf_generate_cpp SRCS HDRS)
+  set(SOURCES)
+  set(HEADERS)
+  foreach(FIL ${ARGN})
+    get_filename_component(ABS_FIL ${FIL} ABSOLUTE)
+    get_filename_component(FIL_WE ${FIL} NAME_WE)
+    list(APPEND SOURCES "${CMAKE_CURRENT_BINARY_DIR}/${FIL_WE}.pb.cc")
+    list(APPEND HEADERS "${CMAKE_CURRENT_BINARY_DIR}/${FIL_WE}.pb.h")
+    add_custom_command(
+      OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/${FIL_WE}.pb.cc" "${CMAKE_CURRENT_BINARY_DIR}/${FIL_WE}.pb.h"
+      COMMAND protobuf::protoc ARGS --cpp_out "${CMAKE_CURRENT_BINARY_DIR}" -I "${CMAKE_CURRENT_SOURCE_DIR}/protocol" "${ABS_FIL}"
+      DEPENDS "${ABS_FIL}" VERBATIM)
+  endforeach()
+  set(${SRCS} ${SOURCES} PARENT_SCOPE)
+  set(${HDRS} ${HEADERS} PARENT_SCOPE)
+endfunction()
