+          .fontWeight = FontWeight::Bold,
+          .color = colorSpecFromRole(ColorRole::OnSurface),
+          .flexGrow = 1.0F,
+      }),
+      ui::toggle({
+          .out = &m_hyprDecorToggle,
+          .checkedImmediate = getHyprDecorations(),
+          .toggleSize = ToggleSize::Medium,
+          .scale = scale,
+          .onChange = [](bool checked) {
+            (void)process::runAsync(std::format("hyprctl eval 'hl.config {{ decoration = {{ blur = {{ enabled = {} }}, rounding = {} }} }}'", checked ? "true" : "false", checked ? 10 : 0));
+          },
+      })
+  );
+  card->addChild(std::move(decorRow));
+
+  // 3. Force Opaque Windows (force_rgbx)
+  auto opaqueRow = ui::row(
+      {.align = FlexAlign::Center, .gap = Style::spaceSm * scale, .minHeight = Style::controlHeightSm * scale},
+      ui::label({
+          .text = "Принудительная непрозрачность",
+          .fontSize = Style::fontSizeBody * scale,
+          .fontWeight = FontWeight::Bold,
+          .color = colorSpecFromRole(ColorRole::OnSurface),
+          .flexGrow = 1.0F,
+      }),
+      ui::toggle({
+          .out = &m_forceOpaqueToggle,
+          .checkedImmediate = false,
+          .toggleSize = ToggleSize::Medium,
+          .scale = scale,
+          .onChange = [](bool checked) {
+            (void)process::runAsync(std::format("hyprctl eval 'hl.window_rule({{ name = \"force-rgbx-toggle\", match = {{ class = \".*\" }}, force_rgbx = {} }})'", checked ? "true" : "false"));
+          },
+      })
+  );
+  card->addChild(std::move(opaqueRow));
+
+  root.addChild(std::move(card));
+}
