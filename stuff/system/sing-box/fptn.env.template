# FPTN Client Environment Configuration
# Copy this template to /etc/credstore/fptn.env and restrict permissions:
#   sudo cp stuff/system/sing-box/fptn.env.template /etc/credstore/fptn.env
#   sudo chmod 600 /etc/credstore/fptn.env

# Required: Authentication token
ACCESS_TOKEN="fptnb:..."

# Optional overrides (if omitted, NixOS module defaults are used):
#
# Preferred server name (case-insensitive)
# Default: Germany-Premium
# Examples: Germany-Premium, United Kingdom-Premium, Netherlands-Premium
PREFERRED_SERVER="Germany-Premium"

# Domain name used for SNI in TLS handshake (used to camouflage traffic)
# Default: rutube.ru
# Examples: rutube.ru, vk.com, cloudflare.com, google.com
SNI="rutube.ru"

# Censorship bypass method
# Default: obfuscation
# Options:
#   obfuscation               - TLS obfuscation
#   sni-spoofing-yandex-26-4  - SNI spoofing with Yandex Browser 26.4
#   sni-spoofing-chrome-149   - SNI spoofing with Chrome 149
#   sni-spoofing-firefox-151  - SNI spoofing with Firefox 151
#   sni-spoofing-safari-26-4  - SNI spoofing with Safari 26.4
BYPASS_METHOD="obfuscation"

# Local VLESS bridge port
# Default: 10808
PORT="10808"
