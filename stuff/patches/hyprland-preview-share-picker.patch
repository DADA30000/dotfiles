+use std::collections::{HashMap, HashSet};
+use std::os::fd::AsFd;
+use std::sync::{Arc, Mutex};
+
+use wayland_client::protocol::wl_buffer::WlBuffer;
+use wayland_client::protocol::wl_output::{self, WlOutput};
+use wayland_client::protocol::wl_registry;
+use wayland_client::{Connection, Dispatch, EventQueue, Proxy, delegate_noop, event_created_child};
+
+use crate::buffer::{Dmabuf, GbmDevice};
+use crate::error::Error;
+use crate::protocols::ext_foreign_toplevel_list_v1::ext_foreign_toplevel_handle_v1::{
+    self, ExtForeignToplevelHandleV1,
+};
+use crate::protocols::ext_foreign_toplevel_list_v1::ext_foreign_toplevel_list_v1::{
+    self, ExtForeignToplevelListV1,
+};
+use crate::protocols::ext_image_capture_source_v1::ext_foreign_toplevel_image_capture_source_manager_v1::ExtForeignToplevelImageCaptureSourceManagerV1;
+use crate::protocols::ext_image_capture_source_v1::ext_image_capture_source_v1::ExtImageCaptureSourceV1;
+use crate::protocols::ext_image_capture_source_v1::ext_output_image_capture_source_manager_v1::ExtOutputImageCaptureSourceManagerV1;
+use crate::protocols::ext_image_copy_capture_v1::ext_image_copy_capture_frame_v1::{
+    self, ExtImageCopyCaptureFrameV1, FailureReason,
+};
+use crate::protocols::ext_image_copy_capture_v1::ext_image_copy_capture_manager_v1::{
+    ExtImageCopyCaptureManagerV1, Options,
+};
+use crate::protocols::ext_image_copy_capture_v1::ext_image_copy_capture_session_v1::{
+    self, ExtImageCopyCaptureSessionV1,
+};
+use crate::protocols::ext_workspace_v1::ext_workspace_group_handle_v1::{
+    self, ExtWorkspaceGroupHandleV1,
+};
+use crate::protocols::ext_workspace_v1::ext_workspace_handle_v1::{self, ExtWorkspaceHandleV1};
+use crate::protocols::ext_workspace_v1::ext_workspace_manager_v1::{self, ExtWorkspaceManagerV1};
+use crate::protocols::hyprland_toplevel_mapping_v1::hyprland_toplevel_mapping_manager_v1::HyprlandToplevelMappingManagerV1;
+use crate::protocols::hyprland_toplevel_mapping_v1::hyprland_toplevel_window_mapping_handle_v1::{
+    self, HyprlandToplevelWindowMappingHandleV1,
+};
+use crate::protocols::hyprland_workspace_image_capture_source_v1::hyprland_workspace_image_capture_source_manager_v1::{
+    CaptureMode, HyprlandWorkspaceImageCaptureSourceManagerV1,
+};
+use crate::protocols::linux_dmabuf_v1::zwp_linux_buffer_params_v1::{Flags, ZwpLinuxBufferParamsV1};
+use crate::protocols::linux_dmabuf_v1::zwp_linux_dmabuf_v1::ZwpLinuxDmabufV1;
+
+#[derive(Clone)]
+struct TrackedWorkspace {
+    name: String,
+    outputs: Vec<String>,
+    handle: ExtWorkspaceHandleV1,
+}
+
+#[derive(Clone)]
+pub struct CaptureManager {
+    connection: Connection,
+    dmabuf: ZwpLinuxDmabufV1,
+    icc_manager: ExtImageCopyCaptureManagerV1,
+    output_source_manager: ExtOutputImageCaptureSourceManagerV1,
+    toplevel_source_manager: ExtForeignToplevelImageCaptureSourceManagerV1,
+    workspace_source_manager: Option<HyprlandWorkspaceImageCaptureSourceManagerV1>,
+    outputs: HashMap<String, WlOutput>,
+    toplevels: HashMap<u64, ExtForeignToplevelHandleV1>,
+    workspaces: Vec<TrackedWorkspace>,
+    supported_dmabuf_formats: Arc<HashSet<(u32, u64)>>,
+    gbm: Arc<Mutex<Option<(u64, GbmDevice)>>>,
+    _toplevel_list: ExtForeignToplevelListV1,
+    _mapping_manager: HyprlandToplevelMappingManagerV1,
+    _workspace_manager: Option<ExtWorkspaceManagerV1>,
+}
+
+impl CaptureManager {
+    pub fn new(connection: &Connection, supported_dmabuf_formats: HashSet<(u32, u64)>) -> Result<Self, Error> {
+        let mut event_queue = connection.new_event_queue();
+        let qhandle = event_queue.handle();
+
+        let mut init = InitState::default();
+        connection.display().get_registry(&qhandle, ());
+
+        event_queue.roundtrip(&mut init).map_err(Error::WaylandDispatch)?;
+
+        let mapping_manager = init
+            .mapping_manager
+            .clone()
+            .ok_or(Error::ProtocolNotAvailable(std::any::type_name::<HyprlandToplevelMappingManagerV1>()))?;
+
+        for (i, (handle, mapped, _)) in init.pending_toplevels.iter_mut().enumerate() {
+            if !*mapped {
+                mapping_manager.get_window_for_toplevel(handle, &qhandle, i);
+                *mapped = true;
+            }
+        }
+
+        event_queue.roundtrip(&mut init).map_err(Error::WaylandDispatch)?;
+        event_queue.roundtrip(&mut init).map_err(Error::WaylandDispatch)?;
+
+        let dmabuf = init.dmabuf.ok_or(Error::ProtocolNotAvailable(std::any::type_name::<ZwpLinuxDmabufV1>()))?;
+        let icc_manager =
+            init.icc_manager.ok_or(Error::ProtocolNotAvailable(std::any::type_name::<ExtImageCopyCaptureManagerV1>()))?;
+        let output_source_manager = init
+            .output_source_manager
+            .ok_or(Error::ProtocolNotAvailable(std::any::type_name::<ExtOutputImageCaptureSourceManagerV1>()))?;
+        let toplevel_source_manager = init.toplevel_source_manager.ok_or(Error::ProtocolNotAvailable(
+            std::any::type_name::<ExtForeignToplevelImageCaptureSourceManagerV1>(),
+        ))?;
+        let toplevel_list =
+            init.toplevel_list.ok_or(Error::ProtocolNotAvailable(std::any::type_name::<ExtForeignToplevelListV1>()))?;
+
+        let mut outputs = HashMap::new();
+        let mut output_names_by_id = HashMap::new();
+        for (wl_output, name) in init.outputs {
+            if let Some(name) = name {
+                output_names_by_id.insert(wl_output.id(), name.clone());
+                outputs.insert(name, wl_output);
+            }
+        }
+
+        let mut toplevels = HashMap::new();
+        for (handle, _, addr) in init.pending_toplevels {
+            if let Some(addr) = addr {
+                toplevels.insert(addr, handle);
+            }
+        }
+
+        let mut workspaces = Vec::new();
+        for ws in init.pending_workspaces {
+            if ws.removed {
+                continue;
+            }
+            let ws_id = ws.handle.id();
+            let mut ws_outputs = Vec::new();
+            for group in &init.workspace_groups {
+                if !group.removed && group.workspaces.iter().any(|w| w.id() == ws_id) {
+                    for out in &group.outputs {
+                        if let Some(name) = output_names_by_id.get(&out.id()) {
+                            ws_outputs.push(name.clone());
+                        }
+                    }
+                    break;
+                }
+            }
+            workspaces.push(TrackedWorkspace { name: ws.name, outputs: ws_outputs, handle: ws.handle });
+        }
+
+        Ok(Self {
+            connection: connection.clone(),
+            dmabuf,
+            icc_manager,
+            output_source_manager,
+            toplevel_source_manager,
+            workspace_source_manager: init.workspace_source_manager,
+            outputs,
+            toplevels,
+            workspaces,
+            supported_dmabuf_formats: Arc::new(supported_dmabuf_formats),
+            gbm: Arc::new(Mutex::new(None)),
+            _toplevel_list: toplevel_list,
+            _mapping_manager: mapping_manager,
+            _workspace_manager: init.workspace_manager,
+        })
+    }
+
+    pub fn capture_output(&self, name: &str) -> Result<Dmabuf, Error> {
+        let wl_output = self.outputs.get(name).ok_or_else(|| Error::NotFound(format!("output {name}")))?;
+        let mut event_queue = self.connection.new_event_queue();
+        let qhandle = event_queue.handle();
+        let source = self.output_source_manager.create_source(wl_output, &qhandle, ());
+        self.capture_source(source, &mut event_queue)
+    }
+
+    pub fn capture_toplevel(&self, window_address: u64) -> Result<Dmabuf, Error> {
+        let handle = self
+            .toplevels
+            .get(&window_address)
+            .ok_or_else(|| Error::NotFound(format!("toplevel {window_address}")))?;
+        let mut event_queue = self.connection.new_event_queue();
+        let qhandle = event_queue.handle();
+        let source = self.toplevel_source_manager.create_source(handle, &qhandle, ());
+        self.capture_source(source, &mut event_queue)
+    }
+
+    pub fn capture_workspace(&self, name: &str, outputs: &[String]) -> Result<Dmabuf, Error> {
+        let ws_mgr = self
+            .workspace_source_manager
+            .as_ref()
+            .ok_or(Error::ProtocolNotAvailable(std::any::type_name::<HyprlandWorkspaceImageCaptureSourceManagerV1>()))?;
+
+        let ws = self
+            .workspaces
+            .iter()
+            .find(|w| w.name == name && outputs.iter().all(|o| w.outputs.contains(o)) && w.outputs.len() == outputs.len())
+            .or_else(|| self.workspaces.iter().find(|w| w.name == name))
+            .ok_or_else(|| Error::NotFound(format!("workspace {name}")))?;
+
+        let mut event_queue = self.connection.new_event_queue();
+        let qhandle = event_queue.handle();
+        let source = ws_mgr.create_source(&ws.handle, CaptureMode::Everything, &qhandle, ());
+        self.capture_source(source, &mut event_queue)
+    }
+
+    fn alloc_dmabuf(&self, state: &CaptureState) -> Result<Dmabuf, Error> {
+        let dev = state
+            .dmabuf_device
+            .ok_or_else(|| Error::BufferCreate("compositor advertised no dmabuf_device".into()))?;
+        let mut guard = self.gbm.lock().expect("lock should not be poisoned");
+        let gbm = match &*guard {
+            Some((cached_dev, gbm)) if *cached_dev == dev => gbm,
+            _ => {
+                *guard = Some((dev, GbmDevice::open(dev)?));
+                &guard.as_ref().unwrap().1
+            }
+        };
+
+        let mut last_err = None;
+        for (fourcc, mods) in &state.dmabuf_formats {
+            let matching: Vec<u64> =
+                mods.iter().copied().filter(|&m| self.supported_dmabuf_formats.contains(&(*fourcc, m))).collect();
+            if matching.is_empty() {
+                continue;
+            }
+            match gbm.alloc(state.width, state.height, *fourcc, &matching) {
+                Ok(dmabuf) => return Ok(dmabuf),
+                Err(err) => last_err = Some(err),
+            }
+        }
+
+        Err(last_err.unwrap_or_else(|| Error::BufferCreate("no mutually supported dmabuf format".into())))
+    }
+
+    fn capture_source(&self, source: ExtImageCaptureSourceV1, event_queue: &mut EventQueue<CaptureState>) -> Result<Dmabuf, Error> {
+        let qhandle = event_queue.handle();
+        let session = self.icc_manager.create_session(&source, Options::empty(), &qhandle, ());
+        let mut state = CaptureState::default();
+
+        for _attempt in 0..3 {
+            while !state.constraints_done && !state.stopped {
+                event_queue.blocking_dispatch(&mut state).map_err(Error::WaylandDispatch)?;
+            }
+            if state.stopped || state.width == 0 || state.height == 0 {
+                session.destroy();
+                source.destroy();
+                return Err(Error::Stopped);
+            }
+
+            let dmabuf = match self.alloc_dmabuf(&state) {
+                Ok(buf) => buf,
+                Err(err) => {
+                    session.destroy();
+                    source.destroy();
+                    return Err(err);
+                }
+            };
+
+            let params = self.dmabuf.create_params(&qhandle, ());
+            for (i, plane) in dmabuf.planes.iter().enumerate() {
+                params.add(
+                    plane.fd.as_fd(),
+                    i as u32,
+                    plane.offset,
+                    plane.stride,
+                    (dmabuf.modifier >> 32) as u32,
+                    dmabuf.modifier as u32,
+                );
+            }
+            let wl_buffer = params.create_immed(
+                state.width as i32,
+                state.height as i32,
+                dmabuf.fourcc,
+                Flags::empty(),
+                &qhandle,
+                (),
+            );
+            params.destroy();
+
+            state.frame_ready = false;
+            state.frame_failed = None;
+            let frame = session.create_frame(&qhandle, ());
+            frame.attach_buffer(&wl_buffer);
+            frame.damage_buffer(0, 0, state.width as i32, state.height as i32);
+            frame.capture();
+
+            while !state.frame_ready && state.frame_failed.is_none() && !state.stopped {
+                event_queue.blocking_dispatch(&mut state).map_err(Error::WaylandDispatch)?;
+            }
+
+            frame.destroy();
+            wl_buffer.destroy();
+
+            if state.frame_ready {
+                session.destroy();
+                source.destroy();
+                return Ok(dmabuf);
+            }
+
+            if matches!(state.frame_failed, Some(FailureReason::BufferConstraints)) && !state.stopped {
+                state.constraints_done = false;
+                continue;
+            }
+
+            session.destroy();
+            source.destroy();
+            return Err(Error::Failed);
+        }
+
+        session.destroy();
+        source.destroy();
+        Err(Error::Failed)
+    }
+}
+
+#[derive(Default)]
+struct PendingGroup {
+    handle: Option<ExtWorkspaceGroupHandleV1>,
+    outputs: Vec<WlOutput>,
+    workspaces: Vec<ExtWorkspaceHandleV1>,
+    removed: bool,
+}
+
+struct PendingWorkspace {
+    handle: ExtWorkspaceHandleV1,
+    name: String,
+    removed: bool,
+}
+
+#[derive(Default)]
+struct InitState {
+    dmabuf: Option<ZwpLinuxDmabufV1>,
+    icc_manager: Option<ExtImageCopyCaptureManagerV1>,
+    output_source_manager: Option<ExtOutputImageCaptureSourceManagerV1>,
+    toplevel_source_manager: Option<ExtForeignToplevelImageCaptureSourceManagerV1>,
+    workspace_source_manager: Option<HyprlandWorkspaceImageCaptureSourceManagerV1>,
+    toplevel_list: Option<ExtForeignToplevelListV1>,
+    mapping_manager: Option<HyprlandToplevelMappingManagerV1>,
+    workspace_manager: Option<ExtWorkspaceManagerV1>,
+    outputs: Vec<(WlOutput, Option<String>)>,
+    pending_toplevels: Vec<(ExtForeignToplevelHandleV1, bool, Option<u64>)>,
+    workspace_groups: Vec<PendingGroup>,
+    pending_workspaces: Vec<PendingWorkspace>,
+}
+
+impl Dispatch<wl_registry::WlRegistry, ()> for InitState {
+    fn event(
+        state: &mut Self,
+        registry: &wl_registry::WlRegistry,
+        event: wl_registry::Event,
+        _: &(),
+        _: &Connection,
+        qhandle: &wayland_client::QueueHandle<Self>,
+    ) {
+        if let wl_registry::Event::Global { name, interface, version } = event {
+            match interface.as_str() {
+                "wl_output" => {
+                    let output: WlOutput = registry.bind(name, version.min(4), qhandle, ());
+                    state.outputs.push((output, None));
+                }
+                "zwp_linux_dmabuf_v1" => {
+                    state.dmabuf = Some(registry.bind(name, version.min(5), qhandle, ()));
+                }
+                "ext_image_copy_capture_manager_v1" => {
+                    state.icc_manager = Some(registry.bind(name, 1, qhandle, ()));
+                }
+                "ext_output_image_capture_source_manager_v1" => {
+                    state.output_source_manager = Some(registry.bind(name, 1, qhandle, ()));
+                }
+                "ext_foreign_toplevel_image_capture_source_manager_v1" => {
+                    state.toplevel_source_manager = Some(registry.bind(name, 1, qhandle, ()));
+                }
+                "hyprland_workspace_image_capture_source_manager_v1" => {
+                    state.workspace_source_manager = Some(registry.bind(name, 1, qhandle, ()));
+                }
+                "ext_foreign_toplevel_list_v1" => {
+                    state.toplevel_list = Some(registry.bind(name, 1, qhandle, ()));
+                }
+                "hyprland_toplevel_mapping_manager_v1" => {
+                    state.mapping_manager = Some(registry.bind(name, 1, qhandle, ()));
+                }
+                "ext_workspace_manager_v1" => {
+                    state.workspace_manager = Some(registry.bind(name, 1, qhandle, ()));
+                }
+                _ => {}
+            }
+        }
+    }
+}
+
+impl Dispatch<WlOutput, ()> for InitState {
+    fn event(
+        state: &mut Self,
+        proxy: &WlOutput,
+        event: wl_output::Event,
+        _: &(),
+        _: &Connection,
+        _: &wayland_client::QueueHandle<Self>,
+    ) {
+        if let wl_output::Event::Name { name } = event
+            && let Some((_, slot)) = state.outputs.iter_mut().find(|(o, _)| o == proxy)
+        {
+            *slot = Some(name);
+        }
+    }
+}
+
+impl Dispatch<ExtForeignToplevelListV1, ()> for InitState {
+    event_created_child!(InitState, ExtForeignToplevelListV1, [
+        ext_foreign_toplevel_list_v1::EVT_TOPLEVEL_OPCODE => (ExtForeignToplevelHandleV1, ())
+    ]);
+
+    fn event(
+        state: &mut Self,
+        _: &ExtForeignToplevelListV1,
+        event: ext_foreign_toplevel_list_v1::Event,
+        _: &(),
+        _: &Connection,
+        qhandle: &wayland_client::QueueHandle<Self>,
+    ) {
+        if let ext_foreign_toplevel_list_v1::Event::Toplevel { toplevel } = event {
+            let idx = state.pending_toplevels.len();
+            let mapped = if let Some(mgr) = &state.mapping_manager {
+                mgr.get_window_for_toplevel(&toplevel, qhandle, idx);
+                true
+            } else {
+                false
+            };
+            state.pending_toplevels.push((toplevel, mapped, None));
+        }
+    }
+}
+
+impl Dispatch<ExtForeignToplevelHandleV1, ()> for InitState {
+    fn event(
+        _: &mut Self,
+        _: &ExtForeignToplevelHandleV1,
+        _: ext_foreign_toplevel_handle_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &wayland_client::QueueHandle<Self>,
+    ) {
+    }
+}
+
+impl Dispatch<HyprlandToplevelWindowMappingHandleV1, usize> for InitState {
+    fn event(
+        state: &mut Self,
+        proxy: &HyprlandToplevelWindowMappingHandleV1,
+        event: hyprland_toplevel_window_mapping_handle_v1::Event,
+        idx: &usize,
+        _: &Connection,
+        _: &wayland_client::QueueHandle<Self>,
+    ) {
+        match event {
+            hyprland_toplevel_window_mapping_handle_v1::Event::WindowAddress { address_hi, address } => {
+                if let Some(entry) = state.pending_toplevels.get_mut(*idx) {
+                    entry.2 = Some(((address_hi as u64) << 32) | (address as u64));
+                }
+                proxy.destroy();
+            }
+            hyprland_toplevel_window_mapping_handle_v1::Event::Failed => proxy.destroy(),
+        }
+    }
+}
+
+impl Dispatch<ExtWorkspaceManagerV1, ()> for InitState {
+    event_created_child!(InitState, ExtWorkspaceManagerV1, [
+        ext_workspace_manager_v1::EVT_WORKSPACE_GROUP_OPCODE => (ExtWorkspaceGroupHandleV1, ()),
+        ext_workspace_manager_v1::EVT_WORKSPACE_OPCODE => (ExtWorkspaceHandleV1, ())
+    ]);
+
+    fn event(
+        state: &mut Self,
+        _: &ExtWorkspaceManagerV1,
+        event: ext_workspace_manager_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &wayland_client::QueueHandle<Self>,
+    ) {
+        match event {
+            ext_workspace_manager_v1::Event::WorkspaceGroup { workspace_group } => {
+                state.workspace_groups.push(PendingGroup {
+                    handle: Some(workspace_group),
+                    ..Default::default()
+                });
+            }
+            ext_workspace_manager_v1::Event::Workspace { workspace } => {
+                state.pending_workspaces.push(PendingWorkspace {
+                    handle: workspace,
+                    name: String::new(),
+                    removed: false,
+                });
+            }
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<ExtWorkspaceGroupHandleV1, ()> for InitState {
+    fn event(
+        state: &mut Self,
+        proxy: &ExtWorkspaceGroupHandleV1,
+        event: ext_workspace_group_handle_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &wayland_client::QueueHandle<Self>,
+    ) {
+        let Some(group) = state.workspace_groups.iter_mut().find(|g| g.handle.as_ref() == Some(proxy)) else {
+            return;
+        };
+        match event {
+            ext_workspace_group_handle_v1::Event::OutputEnter { output } => {
+                if !group.outputs.contains(&output) {
+                    group.outputs.push(output);
+                }
+            }
+            ext_workspace_group_handle_v1::Event::OutputLeave { output } => {
+                group.outputs.retain(|o| o != &output);
+            }
+            ext_workspace_group_handle_v1::Event::WorkspaceEnter { workspace } => {
+                if !group.workspaces.contains(&workspace) {
+                    group.workspaces.push(workspace);
+                }
+            }
+            ext_workspace_group_handle_v1::Event::WorkspaceLeave { workspace } => {
+                group.workspaces.retain(|w| w != &workspace);
+            }
+            ext_workspace_group_handle_v1::Event::Removed => {
+                group.removed = true;
+            }
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<ExtWorkspaceHandleV1, ()> for InitState {
+    fn event(
+        state: &mut Self,
+        proxy: &ExtWorkspaceHandleV1,
+        event: ext_workspace_handle_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &wayland_client::QueueHandle<Self>,
+    ) {
+        let Some(ws) = state.pending_workspaces.iter_mut().find(|w| &w.handle == proxy) else {
+            return;
+        };
+        match event {
+            ext_workspace_handle_v1::Event::Name { name } => ws.name = name,
+            ext_workspace_handle_v1::Event::Removed => ws.removed = true,
+            _ => {}
+        }
+    }
+}
+
+delegate_noop!(InitState: ignore ZwpLinuxDmabufV1);
+delegate_noop!(InitState: ignore ExtImageCopyCaptureManagerV1);
+delegate_noop!(InitState: ignore ExtOutputImageCaptureSourceManagerV1);
+delegate_noop!(InitState: ignore ExtForeignToplevelImageCaptureSourceManagerV1);
+delegate_noop!(InitState: ignore HyprlandWorkspaceImageCaptureSourceManagerV1);
+delegate_noop!(InitState: ignore HyprlandToplevelMappingManagerV1);
+
+#[derive(Default)]
+struct CaptureState {
+    width: u32,
+    height: u32,
+    dmabuf_device: Option<u64>,
+    dmabuf_formats: Vec<(u32, Vec<u64>)>,
+    pending_formats: Vec<(u32, Vec<u64>)>,
+    constraints_done: bool,
+    stopped: bool,
+    frame_ready: bool,
+    frame_failed: Option<FailureReason>,
+}
+
+impl Dispatch<ExtImageCopyCaptureSessionV1, ()> for CaptureState {
+    fn event(
+        state: &mut Self,
+        _: &ExtImageCopyCaptureSessionV1,
+        event: ext_image_copy_capture_session_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &wayland_client::QueueHandle<Self>,
+    ) {
+        match event {
+            ext_image_copy_capture_session_v1::Event::BufferSize { width, height } => {
+                state.width = width;
+                state.height = height;
+            }
+            ext_image_copy_capture_session_v1::Event::DmabufDevice { device } => {
+                if let Ok(bytes) = device.try_into() {
+                    state.dmabuf_device = Some(u64::from_ne_bytes(bytes));
+                }
+            }
+            ext_image_copy_capture_session_v1::Event::DmabufFormat { format, modifiers } => {
+                let mods = modifiers
+                    .chunks_exact(8)
+                    .map(|c| u64::from_ne_bytes(c.try_into().unwrap()))
+                    .collect();
+                state.pending_formats.push((format, mods));
+            }
+            ext_image_copy_capture_session_v1::Event::Done => {
+                state.dmabuf_formats = std::mem::take(&mut state.pending_formats);
+                state.constraints_done = true;
+            }
+            ext_image_copy_capture_session_v1::Event::Stopped => {
+                state.stopped = true;
+            }
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<ExtImageCopyCaptureFrameV1, ()> for CaptureState {
+    fn event(
+        state: &mut Self,
+        _: &ExtImageCopyCaptureFrameV1,
+        event: ext_image_copy_capture_frame_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &wayland_client::QueueHandle<Self>,
+    ) {
+        match event {
+            ext_image_copy_capture_frame_v1::Event::Ready => state.frame_ready = true,
+            ext_image_copy_capture_frame_v1::Event::Failed { reason } => {
+                state.frame_failed = Some(reason.into_result().unwrap_or(FailureReason::Unknown));
+            }
+            _ => {}
+        }
+    }
+}
+
+delegate_noop!(CaptureState: ignore ExtImageCaptureSourceV1);
+delegate_noop!(CaptureState: ignore ZwpLinuxBufferParamsV1);
+delegate_noop!(CaptureState: ignore WlBuffer);
