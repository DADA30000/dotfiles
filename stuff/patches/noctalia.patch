+
+  Flex* m_root = nullptr;
+  Flex* m_statusCard = nullptr;
+  Label* m_activeProxyLabel = nullptr;
+  Toggle* m_finalToggle = nullptr;
+  Label* m_finalStateLabel = nullptr;
+
+  Flex* m_nodesCard = nullptr;
+  Flex* m_nodesList = nullptr;
+  Button* m_testButton = nullptr;
+
+  std::string m_activeProxy;
+  std::string m_finalMode;
+  std::vector<ProxyNode> m_nodes;
+  bool m_needsRebuild = false;
+};
