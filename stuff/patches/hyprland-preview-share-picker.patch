+++ b/src/views/workspaces.rs
@@ -0,0 +1,200 @@
+use std::sync::Arc;
+
+use glib::variant::ToVariant;
+use gtk4::prelude::{BoxExt, ButtonExt, EventControllerExt, NativeExt, WidgetExt};
+use gtk4::{Box, Button, FlowBox, FlowBoxChild, GestureClick, Label, Picture, ScrolledWindow};
+use hyprland_preview_share_picker_lib::buffer::Dmabuf;
+use hyprland_preview_share_picker_lib::capture::CaptureManager;
+use hyprland_preview_share_picker_lib::workspace::Workspace;
+use tokio::sync::oneshot::{Receiver, Sender};
+
+use super::View;
+use crate::config::Config;
+use crate::image::DmabufExt;
+
+pub struct WorkspacesView<'a> {
+    workspaces: &'a [Workspace],
+    config: &'a Config,
+    manager: Arc<CaptureManager>,
+}
+
+impl<'a> WorkspacesView<'a> {
+    pub fn new(workspaces: &'a [Workspace], config: &'a Config, manager: Arc<CaptureManager>) -> Self {
+        Self { workspaces, config, manager }
+    }
+}
+
+impl View for WorkspacesView<'_> {
+    fn build(&self) -> ScrolledWindow {
+        let container = FlowBox::builder()
+            .vexpand(false)
+            .valign(gtk4::Align::Start)
+            .row_spacing(self.config.workspaces.spacing)
+            .column_spacing(self.config.workspaces.spacing)
+            .orientation(gtk4::Orientation::Horizontal)
+            .homogeneous(true)
+            .selection_mode(gtk4::SelectionMode::None)
+            .min_children_per_line(self.config.workspaces.min_per_row)
+            .build();
+        let scrolled_window =
+            ScrolledWindow::builder().child(&container).css_classes([self.config.classes.notebook_page.as_str()]).build();
+
+        let mut cards = 0;
+        self.workspaces.iter().for_each(|workspace| {
+            let card = WorkspaceCard::new(workspace, self.config, self.manager.clone()).build();
+            cards += 1;
+            container.insert(&card, -1);
+        });
+
+        container.set_max_children_per_line(self.config.workspaces.max_per_row.min(cards).max(1));
+
+        scrolled_window
+    }
+
+    fn label(&self) -> Label {
+        Label::builder().css_classes([self.config.classes.tab_label.as_str()]).label("Workspaces").build()
+    }
+}
+
+struct WorkspaceCard<'a> {
+    workspace: &'a Workspace,
+    config: &'a Config,
+    manager: Arc<CaptureManager>,
+}
+
+impl<'a> WorkspaceCard<'a> {
+    fn new(workspace: &'a Workspace, config: &'a Config, manager: Arc<CaptureManager>) -> Self {
+        Self { workspace, config, manager }
+    }
+
+    fn build(self) -> FlowBoxChild {
+        let (tx, rx) = tokio::sync::oneshot::channel();
+        let picture = self.build_picture();
+        let card = self.build_card(&picture);
+        let container = self.build_card_container(&card);
+
+        self.request_frame(tx);
+        self.update_frame_lazily(card, picture, rx);
+
+        container
+    }
+
+    fn build_picture(&self) -> Picture {
+        Picture::builder()
+            .vexpand(false)
+            .valign(gtk4::Align::Start)
+            .height_request(self.config.image.widget_size)
+            .content_fit(gtk4::ContentFit::Contain)
+            .css_classes([self.config.classes.image.as_str()])
+            .build()
+    }
+
+    fn build_card(&self, picture: &Picture) -> Box {
+        let container = Box::builder()
+            .orientation(gtk4::Orientation::Vertical)
+            .vexpand(false)
+            .hexpand(false)
+            .halign(gtk4::Align::Center)
+            .valign(gtk4::Align::Start)
+            .css_classes([self.config.classes.image_card.as_str(), self.config.classes.image_card_loading.as_str()])
+            .build();
+
+        let label_text = if self.workspace.outputs.is_empty() {
+            self.workspace.name.clone()
+        } else {
+            format!("{} ({})", self.workspace.name, self.workspace.outputs.join(", "))
+        };
+
+        let label = Label::builder()
+            .max_width_chars(1)
+            .label(&label_text)
+            .ellipsize(gtk4::pango::EllipsizeMode::End)
+            .single_line_mode(true)
+            .css_classes([self.config.classes.image_label.as_str()])
+            .hexpand(false)
+            .build();
+
+        container.append(picture);
+        container.append(&label);
+        container
+    }
+
+    fn build_card_container(&self, card: &Box) -> FlowBoxChild {
+        let button = Button::builder()
+            .focusable(true)
+            .halign(gtk4::Align::Center)
+            .valign(gtk4::Align::Start)
+            .child(card)
+            .build();
+        let container = FlowBoxChild::builder()
+            .focusable(false)
+            .halign(gtk4::Align::Fill)
+            .valign(gtk4::Align::Start)
+            .child(&button)
+            .build();
+
+        let gesture = GestureClick::new();
+        gesture.set_propagation_phase(gtk4::PropagationPhase::Capture);
+        let clicks = self.config.workspaces.clicks;
+        let id = self.workspace.id;
+        gesture.connect_released(move |gesture, n, _, _| {
+            if n as i64 == clicks as i64
+                && let Some(widget) = gesture.widget()
+            {
+                widget
+                    .activate_action("win.select", Some(&format!("workspace-id:{id}").to_variant()))
+                    .expect("select action should be registered on the window")
+            }
+        });
+        button.add_controller(gesture);
+        button.connect_activate(move |child| {
+            child
+                .activate_action("win.select", Some(&format!("workspace-id:{id}").to_variant()))
+                .expect("select action should be registered on the window")
+        });
+        container
+    }
+
+    fn request_frame(&self, tx: Sender<Dmabuf>) {
+        let id = self.workspace.id;
+        let name = self.workspace.name.clone();
+        let outputs = self.workspace.outputs.clone();
+        let manager = self.manager.clone();
+
+        tokio::spawn(async move {
+            let dmabuf = match manager.capture_workspace(&name, &outputs) {
+                Ok(dmabuf) => dmabuf,
+                Err(err) => return log::error!("unable to capture frame for workspace {id} ({name}): {err}"),
+            };
+
+            if tx.send(dmabuf).is_err() {
+                log::error!("unable to transmit dmabuf for workspace {id}: channel is closed");
+            }
+            log::debug!("transmitted dmabuf for workspace {id}");
+        });
+    }
+
+    fn update_frame_lazily(&self, card: Box, picture: Picture, rx: Receiver<Dmabuf>) {
+        let id = self.workspace.id;
+        let loading_class = self.config.classes.image_card_loading.clone();
+        let resize_size = (!self.config.image.disable_resize).then_some(self.config.image.resize_size);
+        glib::spawn_future_local(async move {
+            let dmabuf = match rx.await {
+                Ok(dmabuf) => dmabuf,
+                Err(err) => {
+                    log::error!("unable to receive dmabuf for workspace {id}: {err}");
+                    card.remove_css_class(&loading_class);
+                    return;
+                }
+            };
+
+            let display = picture.display();
+            let renderer = picture.native().and_then(|n| n.renderer());
+            match dmabuf.into_texture(&display, resize_size, renderer.as_ref()) {
+                Ok(texture) => picture.set_paintable(Some(&texture)),
+                Err(err) => log::error!("unable to create texture for workspace {id}: {err}"),
+            }
+            card.remove_css_class(&loading_class);
+        });
+    }
+}
