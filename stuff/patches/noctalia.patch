+void VpnTab::doUpdate(Renderer& renderer) {
+  if (m_needsRebuild) {
+    m_needsRebuild = false;
+    rebuildNodeList();
+    if (m_root) m_root->layout(renderer);
+  }
+}
+
+void VpnTab::fetchProxies() {
+  std::thread([this]() {
+    const std::string proxyJson = apiGet("/proxies/proxy");
+    const std::string finalJson = apiGet("/proxies/final-toggle");
+    std::string active;
+    std::vector<ProxyNode> nodes;
+    std::string finalMode = "direct";
+
+    try {
+      if (!proxyJson.empty()) {
+        auto root = nlohmann::json::parse(proxyJson);
+        active = root.value("now", "");
+        if (root.contains("all") && root["all"].is_array()) {
+          for (const auto& item : root["all"]) {
+            std::string name = item.get<std::string>();
+            nodes.push_back(ProxyNode{.name = name, .active = (name == active), .delayMs = -1});
+          }
+        }
+      }
+      if (!finalJson.empty()) finalMode = nlohmann::json::parse(finalJson).value("now", "direct");
+    } catch (...) {}
+
+    DeferredCall::callLater([this, active = std::move(active), finalMode = std::move(finalMode), nodes = std::move(nodes)]() mutable {
+      m_activeProxy = std::move(active);
+      m_finalMode = std::move(finalMode);
+      m_nodes = std::move(nodes);
+      rebuildNodeList();
+      PanelManager::instance().requestLayout();
+      PanelManager::instance().requestRedraw();
+    });
+  }).detach();
+}
+
+void VpnTab::selectProxy(const std::string& name) {
+  std::thread([this, name]() {
+    if (apiPut("/proxies/proxy", std::format("{{\"name\": \"{}\"}}", name))) {
+      DeferredCall::callLater([this, name]() {
+        m_activeProxy = name;
+        for (auto& n : m_nodes) n.active = (n.name == name);
+        rebuildNodeList();
+        PanelManager::instance().refresh();
+      });
+    }
+  }).detach();
+}
+
+void VpnTab::setFinalRoute(bool toProxy) {
+  std::thread([this, toProxy]() {
+    const std::string target = toProxy ? "proxy" : "direct";
+    if (apiPut("/proxies/final-toggle", std::format("{{\"name\": \"{}\"}}", target))) {
+      DeferredCall::callLater([this, target]() {
+        m_finalMode = target;
+        rebuildNodeList();
+        PanelManager::instance().requestLayout();
+        PanelManager::instance().requestRedraw();
+      });
+    }
+  }).detach();
+}
+
+void VpnTab::testAllLatencies() {
+  if (m_testButton) {
+    m_testButton->setText("Тестирование...");
+    m_testButton->setHitTestVisible(false);
+  }
+  std::vector<std::string> names;
+  names.reserve(m_nodes.size());
+  for (const auto& n : m_nodes) names.push_back(n.name);
+
+  std::thread([this, names = std::move(names)]() {
+    std::unordered_map<std::string, int> delays;
+    for (const auto& name : names) {
+      const std::string out = apiGet(std::format("/proxies/{}/delay?timeout=2500&url=http://www.gstatic.com/generate_204", name));
+      int delay = -1;
+      try {
+        if (!out.empty()) delay = nlohmann::json::parse(out).value("delay", -1);
+      } catch (...) {}
+      delays[name] = delay;
+    }
+    DeferredCall::callLater([this, delays = std::move(delays)]() {
+      for (auto& n : m_nodes) {
+        if (auto it = delays.find(n.name); it != delays.end()) n.delayMs = it->second;
+      }
+      rebuildNodeList();
+      if (m_testButton) {
+        m_testButton->setText(i18n::tr("control-center.vpn.ping"));
+        m_testButton->setHitTestVisible(true);
+      }
+      PanelManager::instance().refresh();
+    });
+  }).detach();
+}
+
+void VpnTab::rebuildNodeList() {
+  const float scale = contentScale();
+  if (m_activeProxyLabel) m_activeProxyLabel->setText(m_activeProxy.empty() ? "--" : m_activeProxy);
+  if (m_finalToggle) m_finalToggle->setCheckedImmediate(m_finalMode == "proxy");
+  if (m_finalStateLabel) m_finalStateLabel->setText(m_finalMode == "proxy" ? "Режим: proxy (через VPN)" : "Режим: direct (напрямую)");
+  if (!m_nodesList) return;
+
+  while (!m_nodesList->children().empty()) {
+    m_nodesList->removeChild(m_nodesList->children().front().get());
+  }
+
+  for (const auto& node : m_nodes) {
+    const bool act = (node.name == m_activeProxy);
+    auto row = ui::button({
+        .variant = act ? ButtonVariant::Primary : ButtonVariant::Default,
+        .paddingV = Style::spaceSm * scale, .paddingH = Style::spaceMd * scale,
+        .radius = Style::scaledRadiusMd(scale),
+        .onClick = [this, name = node.name]() { selectProxy(name); },
+    });
+    row->setDirection(FlexDirection::Horizontal);
+    row->setAlign(FlexAlign::Center);
+    row->setGap(Style::spaceSm * scale);
+    row->setMinHeight(Style::controlHeightSm * scale);
+
+    row->addChild(ui::glyph({
+        .glyph = act ? "shield-check" : "shield-lock", .glyphSize = Style::baseGlyphSize * scale,
+        .color = colorSpecFromRole(act ? ColorRole::OnPrimary : ColorRole::OnSurface),
+    }));
+    row->addChild(ui::label({
+        .text = node.name, .fontSize = Style::fontSizeBody * scale,
+        .fontWeight = act ? FontWeight::Bold : FontWeight::Normal,
+        .color = colorSpecFromRole(act ? ColorRole::OnPrimary : ColorRole::OnSurface),
+        .flexGrow = 1.0F,
+    }));
+    row->addChild(ui::label({
+        .text = node.delayMs > 0 ? std::format("{} ms", node.delayMs) : "--",
+        .fontSize = Style::fontSizeCaption * scale, .fontWeight = FontWeight::Medium,
+        .color = colorSpecFromRole(act ? ColorRole::OnPrimary : ColorRole::Tertiary),
+    }));
+    m_nodesList->addChild(std::move(row));
+  }
+}
