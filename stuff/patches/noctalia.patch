+            try {
+              double u = std::stod(StringUtils::trim(parts[0]));
+              double mUsed = std::stod(StringUtils::trim(parts[1])) / 1024.0;
+              double mTot = std::stod(StringUtils::trim(parts[2])) / 1024.0;
