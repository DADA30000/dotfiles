+fn rom_config_path() -> Option<PathBuf> {
+  if let Ok(config_home) = env::var("XDG_CONFIG_HOME")
+    && !config_home.is_empty()
+  {
+    return Some(PathBuf::from(config_home).join("rom").join("config.toml"));
+  }
+  env::var_os("HOME")
+    .map(|home| PathBuf::from(home).join(".config").join("rom").join("config.toml"))
+}
+
+fn load_rom_config() -> Config {
+  let mut config = Config::default();
+  let Some(path) = rom_config_path() else {
+    return config;
+  };
+  let text = match fs::read_to_string(&path) {
+    Ok(text) => text,
+    Err(error) if error.kind() == ErrorKind::NotFound => return config,
+    Err(error) => {
+      warn!(path = %path.display(), %error, "failed to read rom config");
+      return config;
+    },
+  };
+  let doc = match text.parse::<DocumentMut>() {
+    Ok(doc) => doc,
+    Err(error) => {
+      warn!(path = %path.display(), %error, "failed to parse rom config");
+      return config;
+    },
+  };
+
+  if let Some(value) = doc.get("format").and_then(|v| v.as_str()) {
+    match value {
+      "tree" => config.render.format = DisplayFormat::Tree,
+      "plain" => config.render.format = DisplayFormat::Plain,
+      "dashboard" => config.render.format = DisplayFormat::Dashboard,
+      other => warn!(value = other, "unknown rom format in config.toml"),
+    }
+  }
+  if let Some(value) = doc.get("tree-direction").and_then(|v| v.as_str()) {
+    match value {
+      "down" => config.render.tree_direction = TreeDirection::Down,
+      "up" => config.render.tree_direction = TreeDirection::Up,
+      other => {
+        warn!(value = other, "unknown rom tree-direction in config.toml");
+      },
+    }
+  }
+  if let Some(value) = doc.get("legend").and_then(|v| v.as_str()) {
+    match value {
+      "compact" => config.render.legend_style = LegendStyle::Compact,
+      "table" => config.render.legend_style = LegendStyle::Table,
+      "verbose" => config.render.legend_style = LegendStyle::Verbose,
+      "nom" => config.render.legend_style = LegendStyle::Nom,
+      other => warn!(value = other, "unknown rom legend in config.toml"),
+    }
+  }
+  if let Some(value) = doc.get("summary").and_then(|v| v.as_str()) {
+    match value {
+      "concise" => config.render.summary_style = SummaryStyle::Concise,
+      "table" => config.render.summary_style = SummaryStyle::Table,
+      "full" => config.render.summary_style = SummaryStyle::Full,
+      "nom" => config.render.summary_style = SummaryStyle::Nom,
+      other => warn!(value = other, "unknown rom summary in config.toml"),
+    }
+  }
+  if let Some(value) = doc.get("icons").and_then(|v| v.as_str()) {
+    match value {
+      "auto" => config.render.icons = IconMode::Auto,
+      "unicode" => config.render.icons = IconMode::Unicode,
+      "nerd" => config.render.icons = IconMode::Nerd,
+      other => warn!(value = other, "unknown rom icons in config.toml"),
+    }
+  }
+  if let Some(value) = doc.get("log-prefix").and_then(|v| v.as_str()) {
+    match value {
+      "short" => config.engine.log_prefix_style = LogPrefixStyle::Short,
+      "full" => config.engine.log_prefix_style = LogPrefixStyle::Full,
+      "none" => config.engine.log_prefix_style = LogPrefixStyle::None,
+      other => warn!(value = other, "unknown rom log-prefix in config.toml"),
+    }
+  }
+  if let Some(value) = doc.get("log-lines").and_then(|v| v.as_integer())
+    && let Ok(limit) = usize::try_from(value)
+  {
+    config.engine.log_line_limit = Some(limit);
+  }
+  if let Some(value) = doc.get("host-sort").and_then(|v| v.as_str()) {
+    match value {
+      "none" => config.render.host_sort = HostSort::None,
+      "download-size" => config.render.host_sort = HostSort::DownloadSize,
+      "download-count" => config.render.host_sort = HostSort::DownloadCount,
+      "builds" => config.render.host_sort = HostSort::Builds,
+      other => warn!(value = other, "unknown rom host-sort in config.toml"),
+    }
+  }
+  if let Some(value) = doc.get("max-hosts").and_then(|v| v.as_integer())
+    && let Ok(cap) = usize::try_from(value)
+  {
+    config.render.max_hosts = Some(cap);
+  }
+  if let Some(value) = doc.get("curl-progress").and_then(|v| v.as_bool()) {
+    config.engine.curl_progress = value;
+  }
+  if let Some(value) = doc.get("progress-bars").and_then(|v| v.as_bool()) {
+    config.render.progress_bars = value;
+  }
+  if let Some(value) = doc.get("show-percentages").and_then(|v| v.as_bool()) {
+    config.render.show_percentages = value;
+  }
+  if let Some(value) = doc.get("decimal-bytes").and_then(|v| v.as_bool()) {
+    config.render.decimal_bytes = value;
+  }
+
+  if let Some(theme) = doc.get("theme").and_then(|v| v.as_table_like()) {
+    let parse_color = |key: &str| -> Option<Color> {
+      let raw = theme.get(key)?.as_str()?;
+      match Color::from_str(raw) {
+        Ok(color) => Some(color),
+        Err(error) => {
+          warn!(key, value = raw, %error, "invalid color in rom [theme]");
+          None
+        },
+      }
+    };
+    let target = &mut config.render.theme;
+    if let Some(c) = parse_color("connector") {
+      target.connector = c;
+    }
+    if let Some(c) = parse_color("text") {
+      target.text = c;
+    }
+    if let Some(c) = parse_color("muted") {
+      target.muted = c;
+    }
+    if let Some(c) = parse_color("timer") {
+      target.timer = c;
+    }
+    if let Some(c) = parse_color("planned") {
+      target.planned = c;
+    }
+    if let Some(c) = parse_color("running") {
+      target.running = c;
+    }
+    if let Some(c) = parse_color("completed") {
+      target.completed = c;
+    }
+    if let Some(c) = parse_color("failed") {
+      target.failed = c;
+    }
+    if let Some(c) = parse_color("log-prefix") {
+      target.log_prefix = c;
+    }
+    if let Some(c) = parse_color("host") {
+      target.host = c;
+    }
+    if let Some(c) = parse_color("download") {
+      target.download = c;
+    }
+    if let Some(c) = parse_color("upload") {
+      target.upload = c;
+    }
+    if let Some(c) = parse_color("transfer-bytes") {
+      target.transfer_bytes = c;
+    }
+    if let Some(c) = parse_color("progress-track") {
+      target.progress_track = c;
+    }
+    if let Some(c) = parse_color("cpu") {
+      target.cpu = c;
+    }
+    if let Some(c) = parse_color("cpu-serial") {
+      target.cpu_serial = c;
+    }
+    if let Some(c) = parse_color("cpu-idle") {
+      target.cpu_idle = c;
+    }
+    if let Some(c) = parse_color("cpu-heavy") {
+      target.cpu_heavy = c;
+    }
+  }
+
+  config
+}
