+  auto makeRow = [&](std::string_view label, std::unique_ptr<Node> ctrl) {
+    auto r = ui::row({.align = FlexAlign::Center, .gap = Style::spaceSm * scale, .minHeight = Style::controlHeightSm * scale});
+    r->addChild(ui::label({
+        .text = std::string(label), .fontSize = Style::fontSizeBody * scale,
+        .fontWeight = FontWeight::Bold, .color = colorSpecFromRole(ColorRole::OnSurface), .flexGrow = 1.0F
+    }));
+    r->addChild(std::move(ctrl));
+    return r;
+  };
+
+  if (hasNv) {
+    card->addChild(makeRow("Блокировка NVIDIA GPU", ui::toggle({
+        .out = &m_nvBlindfoldToggle, .checkedImmediate = isNvBlocked(),
+        .toggleSize = ToggleSize::Medium, .scale = scale,
+        .onChange = [](bool checked) { sendDaemonCommand(checked ? "nv block" : "nv unblock"); },
+    })));
+  }
+
+  if (hasFan) {
+    const std::string curFan = getFanMode();
+    std::vector<ui::SegmentedOption> fanOpts = {{.label = "Quiet", .glyph = "wind"}, {.label = "Auto", .glyph = "wind"}, {.label = "Max", .glyph = "wind"}};
+    auto fanSeg = ui::segmented({
+        .out = &m_fanModeSegmented,
+        .options = std::move(fanOpts),
+        .fontSize = Style::fontSizeCaption, .scale = scale, .surfaceOpacity = panelCardOpacity(),
+        .surfaceRole = ColorRole::Surface, .equalSegmentWidths = true,
+        .onChange = [](std::size_t idx) {
+          sendDaemonCommand(std::format("fan {}", idx == 2 ? "max" : (idx == 0 ? "quiet" : "auto")));
+        },
+    });
+    if (m_fanModeSegmented) m_fanModeSegmented->setSelectedIndex(curFan == "max" ? 2 : (curFan == "quiet" ? 0 : 1));
+    card->addChild(makeRow("Режим вентиляторов", std::move(fanSeg)));
+  }
+
+  if (hasRyzen) {
+    m_ryzenUnlocked = checkRyzenUnlocked();
+    card->addChild(makeRow("Лимиты мощности AMD CPU", ui::button({
+        .out = &m_ryzenadjButton,
+        .text = m_ryzenUnlocked ? "Лимиты сняты" : "Снять лимиты",
+        .variant = m_ryzenUnlocked ? ButtonVariant::Ghost : ButtonVariant::Primary,
+        .padding = Style::spaceSm * scale, .radius = Style::scaledRadiusSm(scale),
+        .onClick = [this]() {
+          static std::atomic<bool> s_unlocking{false};
+          if (s_unlocking.exchange(true)) return;
+          if (m_ryzenadjButton) m_ryzenadjButton->setText("Снятие лимитов...");
+          std::thread([this]() {
+            sendDaemonCommand("ryzen max");
+            std::this_thread::sleep_for(std::chrono::milliseconds(300));
+            if (auto newLim = queryCurrentRyzenLimits()) recordMaxLimits(*newLim);
+            bool unlocked = checkRyzenUnlocked();
+            DeferredCall::callLater([this, unlocked]() {
+              s_unlocking = false;
+              if (m_ryzenadjButton) {
+                m_ryzenUnlocked = unlocked;
+                m_ryzenadjButton->setText(unlocked ? "Лимиты сняты" : "Снять лимиты");
+                m_ryzenadjButton->setVariant(unlocked ? ButtonVariant::Ghost : ButtonVariant::Primary);
+                PanelManager::instance().requestRedraw();
+              }
+            });
+          }).detach();
+        },
+    })));
+  }
+  root.addChild(std::move(card));
+}
