diff --git a/src/system/nvidia_status.h b/src/system/nvidia_status.h
new file mode 100644
index 0000000..ac9c0cf
--- /dev/null
+++ b/src/system/nvidia_status.h
@@ -0,0 +1,172 @@
+#pragma once
+
+#include "util/file_utils.h"
+#include "util/string_utils.h"
+
+#include <atomic>
+#include <chrono>
+#include <dlfcn.h>
+#include <filesystem>
+#include <format>
+#include <mutex>
+#include <string>
+#include <thread>
+
+namespace noctalia::system {
+
+struct NvidiaGpuStatus {
+  bool present = false, suspended = false, blocked = false;
+  std::string runtimeUsage = "0";
+  double usagePct = 0.0, vramUsedMib = 0.0, vramTotalMib = 0.0, tempC = 0.0;
+
+  [[nodiscard]] std::string formatSummary() const {
+    if (!present) return {};
+    if (suspended) return "D3cold";
+    if (blocked) return std::format("blocked (usage: {})", runtimeUsage);
+    return std::format("{:.0F}% · {:.1F}/{:.1F} GiB", usagePct, vramUsedMib / 1024.0, vramTotalMib / 1024.0);
+  }
+};
+
+class NvidiaGpuService {
+public:
+  static NvidiaGpuService& instance() {
+    static NvidiaGpuService s;
+    return s;
+  }
+
+  [[nodiscard]] static bool isNvBlocked() {
+    std::error_code ec;
+    for (const auto& e : std::filesystem::directory_iterator("/dev", ec)) {
+      if (e.path().filename().string().starts_with("nvidia") &&
+          (e.status(ec).permissions() & std::filesystem::perms::all) == std::filesystem::perms::none) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  NvidiaGpuStatus status() {
+    refreshAsync();
+    std::lock_guard<std::mutex> lk(m_mutex);
+    return m_cached;
+  }
+
+  void refreshAsync() {
+    const auto now = std::chrono::steady_clock::now();
+    {
+      std::lock_guard<std::mutex> lk(m_mutex);
+      if (now - m_lastQuery < std::chrono::milliseconds(900)) return;
+      m_lastQuery = now;
+    }
+    if (m_running.exchange(true)) return;
+    std::thread([this]() {
+      queryBackground();
+      m_running = false;
+    }).detach();
+  }
+
+private:
+  NvidiaGpuService() = default;
+  ~NvidiaGpuService() {
+    while (m_running.load()) std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    closeNvml();
+  }
+
+  std::string findPciDev() {
+    if (!m_pciDev.empty()) return m_pciDev;
+    std::error_code ec;
+    for (const auto& d : std::filesystem::directory_iterator("/sys/bus/pci/devices", ec)) {
+      auto v = FileUtils::readSmallTextFile(d.path() / "vendor");
+      if (v && StringUtils::trim(*v) == "0x10de") return m_pciDev = d.path().string();
+    }
+    return {};
+  }
+
+  void queryBackground() {
+    const std::string dev = findPciDev();
+    if (dev.empty()) {
+      std::lock_guard<std::mutex> lk(m_mutex);
+      m_cached.present = false;
+      return;
+    }
+    NvidiaGpuStatus st{.present = true};
+    auto rStat = FileUtils::readSmallTextFile(dev + "/power/runtime_status");
+    if (rStat && StringUtils::trim(*rStat) == "suspended") {
+      st.suspended = true;
+    } else if (isNvBlocked()) {
+      st.blocked = true;
+      auto u = FileUtils::readSmallTextFile(dev + "/power/runtime_usage");
+      st.runtimeUsage = u ? StringUtils::trim(*u) : "0";
+    } else {
+      queryNvml(st);
+    }
+    std::lock_guard<std::mutex> lk(m_mutex);
+    m_cached = st;
+  }
+
+  using NvDev = void*;
+  struct NvUtil { unsigned int gpu, memory; };
+  struct NvMem { unsigned long long total, free, used; };
+  void* m_lib = nullptr;
+  NvDev m_dev = nullptr;
+  int (*m_init)() = nullptr;
+  int (*m_shutdown)() = nullptr;
+  int (*m_getHandle)(unsigned int, NvDev*) = nullptr;
+  int (*m_getUtil)(NvDev, NvUtil*) = nullptr;
+  int (*m_getTemp)(NvDev, int, unsigned int*) = nullptr;
+  int (*m_getMem)(NvDev, NvMem*) = nullptr;
+
+  bool ensureNvml() {
+    if (m_dev) return true;
+    if (!m_lib) {
+      m_lib = dlopen("libnvidia-ml.so.1", RTLD_LAZY | RTLD_LOCAL);
+      if (!m_lib) m_lib = dlopen("/run/opengl-driver/lib/libnvidia-ml.so.1", RTLD_LAZY | RTLD_LOCAL);
+      if (!m_lib) return false;
+    }
+    m_init = (int(*)())dlsym(m_lib, "nvmlInit_v2");
+    if (!m_init) m_init = (int(*)())dlsym(m_lib, "nvmlInit");
+    m_shutdown = (int(*)())dlsym(m_lib, "nvmlShutdown");
+    m_getHandle = (int(*)(unsigned int, NvDev*))dlsym(m_lib, "nvmlDeviceGetHandleByIndex_v2");
+    if (!m_getHandle) m_getHandle = (int(*)(unsigned int, NvDev*))dlsym(m_lib, "nvmlDeviceGetHandleByIndex");
+    m_getUtil = (int(*)(NvDev, NvUtil*))dlsym(m_lib, "nvmlDeviceGetUtilizationRates");
+    m_getTemp = (int(*)(NvDev, int, unsigned int*))dlsym(m_lib, "nvmlDeviceGetTemperature");
+    m_getMem = (int(*)(NvDev, NvMem*))dlsym(m_lib, "nvmlDeviceGetMemoryInfo");
+    if (!m_init || !m_getHandle || !m_getMem || m_init() != 0 || m_getHandle(0, &m_dev) != 0 || !m_dev) {
+      return false;
+    }
+    return true;
+  }
+
+  void closeNvml() {
+    if (m_shutdown) m_shutdown();
+    if (m_lib) { dlclose(m_lib); m_lib = nullptr; }
+    m_dev = nullptr;
+  }
+
+  void queryNvml(NvidiaGpuStatus& st) {
+    if (!ensureNvml()) return;
+    if (m_getUtil) {
+      NvUtil u{};
+      if (m_getUtil(m_dev, &u) == 0 && u.gpu <= 100) st.usagePct = static_cast<double>(u.gpu);
+    }
+    if (m_getTemp) {
+      unsigned int t = 0;
+      if (m_getTemp(m_dev, 0, &t) == 0) st.tempC = static_cast<double>(t);
+    }
+    if (m_getMem) {
+      NvMem m{};
+      if (m_getMem(m_dev, &m) == 0 && m.total > 0) {
+        st.vramUsedMib = static_cast<double>(m.used) / (1024.0 * 1024.0);
+        st.vramTotalMib = static_cast<double>(m.total) / (1024.0 * 1024.0);
+      }
+    }
+  }
+
+  std::string m_pciDev;
+  NvidiaGpuStatus m_cached{};
+  std::mutex m_mutex;
+  std::atomic<bool> m_running{false};
+  std::chrono::steady_clock::time_point m_lastQuery{};
+};
+
+} // namespace noctalia::system
