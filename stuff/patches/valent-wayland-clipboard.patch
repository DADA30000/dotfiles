+
+static void
+device_selection (void *data,
+                  struct zwlr_data_control_device_v1 *dev,
+                  struct zwlr_data_control_offer_v1 *offer)
+{
+  ValentGdkClipboard *self = VALENT_GDK_CLIPBOARD (data);
+
+  if (self->is_our_selection)
+    {
+      self->is_our_selection = FALSE;
+      if (offer != NULL)
+        zwlr_data_control_offer_v1_destroy (offer);
+      return;
+    }
+
+  if (offer == NULL)
+    {
+      g_clear_pointer (&self->wlr_text, g_free);
+      return;
+    }
+
+  int p[2];
+  if (pipe2 (p, O_CLOEXEC) < 0)
+    {
+      zwlr_data_control_offer_v1_destroy (offer);
+      return;
+    }
+
+  zwlr_data_control_offer_v1_receive (offer, "text/plain;charset=utf-8", p[1]);
+  close (p[1]);
+  wl_display_flush (self->wl_display);
+
+  GByteArray *array = g_byte_array_new ();
+  char buf[4096];
+  ssize_t n;
+  while ((n = read (p[0], buf, sizeof (buf))) > 0)
+    {
+      g_byte_array_append (array, (const guint8 *)buf, n);
+      if (array->len > CLIPBOARD_MAXSIZE)
+        break;
+    }
+  close (p[0]);
+  zwlr_data_control_offer_v1_destroy (offer);
+
+  if (array->len > 0)
+    {
+      if (array->data[array->len - 1] != '\0')
+        {
+          guint8 zero = 0;
+          g_byte_array_append (array, &zero, 1);
+        }
+
+      char *new_text = (char *)g_byte_array_free (array, FALSE);
+
+      if (g_strcmp0 (self->wlr_text, new_text) != 0)
+        {
+          g_free (self->wlr_text);
+          self->wlr_text = new_text;
+          self->timestamp = valent_timestamp_ms ();
+          valent_clipboard_adapter_changed (VALENT_CLIPBOARD_ADAPTER (self));
+        }
+      else
+        {
+          g_free (new_text);
+        }
+    }
+  else
+    {
+      g_byte_array_free (array, TRUE);
+    }
+}
