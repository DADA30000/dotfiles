+    struct timeval tv{.tv_sec = 0, .tv_usec = 200000};
+    ::setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    ::setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+
+    if (::connect(fd, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr)) < 0) {
+      ::close(fd);
+      return {};
+    }
+    std::string msg = std::string(cmd) + "\n";
+    if (::write(fd, msg.data(), msg.size()) < 0) {
+      ::close(fd);
+      return {};
+    }
+    char buf[256];
+    ssize_t n = ::read(fd, buf, sizeof(buf) - 1);
+    ::close(fd);
+    if (n <= 0) return {};
+    buf[n] = '\0';
+    return StringUtils::trim(buf);
+  }
+
+  bool isAmdRyzenCpu() {
+    static bool checked = false;
+    static bool isAmd = false;
+    if (!checked) {
+      checked = true;
+      std::ifstream file{"/proc/cpuinfo"};
+      std::string line;
+      while (std::getline(file, line)) {
+        if (line.find("AuthenticAMD") != std::string::npos || line.find("AMD") != std::string::npos) {
+          isAmd = true;
+          break;
+        }
+      }
+    }
+    return isAmd;
+  }
+
+  bool isSmuLoaded() {
+    std::error_code ec;
+    return std::filesystem::exists("/sys/kernel/ryzen_smu_drv", ec)
+        || std::filesystem::exists("/sys/kernel/ryzen_smu", ec);
+  }
+
+  bool hasRyzenAdj() {
+    static const bool supported = isAmdRyzenCpu() && isSmuLoaded();
+    return supported;
+  }
+
+  bool hasAorusFan() {
+    std::error_code ec;
+    return std::filesystem::exists("/sys/devices/platform/aorus_laptop/fan_mode", ec);
+  }
+
+  std::string getFanMode() {
+    auto res = sendDaemonCommand("fan get");
+    if (!res.empty() && res != "unknown" && res != "error") {
+      return res;
+    }
+    auto s = FileUtils::readSmallTextFile("/sys/devices/platform/aorus_laptop/fan_mode");
+    if (s.has_value()) {
+      std::string val = StringUtils::trim(*s);
+      if (val == "5") return "max";
+      if (val == "3") return "quiet";
+    }
+    return "auto";
+  }
+
+  bool isNvBlocked() {
+    auto res = sendDaemonCommand("nv status");
+    if (!res.empty()) {
+      return res == "blocked";
+    }
+    return noctalia::system::NvidiaGpuService::isNvBlocked();
+  }
+
+  struct RyzenLimits {
+    double stapm = 0.0;
+    double fast = 0.0;
+    double slow = 0.0;
+
+    [[nodiscard]] bool valid() const noexcept {
+      return stapm > 0.0 && fast > 0.0 && slow > 0.0;
+    }
+
+    [[nodiscard]] bool isAtOrAbove(const RyzenLimits& maxLim, double tolerance = 1.0) const noexcept {
+      if (!maxLim.valid()) return false;
+      return stapm >= (maxLim.stapm - tolerance)
+          && fast >= (maxLim.fast - tolerance)
+          && slow >= (maxLim.slow - tolerance);
+    }
+  };
+
+  static RyzenLimits s_recordedMaxLimits{};
+  static bool s_maxLimitsLoaded = false;
+  static std::mutex s_ryzenMutex;
+
+  std::string ryzenMaxLimitFilePath() {
+    std::string dir = FileUtils::stateDir();
+    if (dir.empty()) dir = "/tmp";
+    return dir + "/ryzen_max_limits";
+  }
+
+  RyzenLimits getRecordedMaxLimits() {
+    std::lock_guard<std::mutex> lk(s_ryzenMutex);
+    if (!s_maxLimitsLoaded) {
+      s_maxLimitsLoaded = true;
+      if (auto s = FileUtils::readSmallTextFile(ryzenMaxLimitFilePath())) {
+        std::istringstream iss(*s);
+        iss >> s_recordedMaxLimits.stapm >> s_recordedMaxLimits.fast >> s_recordedMaxLimits.slow;
+      }
+    }
+    return s_recordedMaxLimits;
+  }
+
+  void recordMaxLimits(const RyzenLimits& lim) {
+    if (!lim.valid()) return;
+    auto cur = getRecordedMaxLimits();
+    bool chg = false;
+    if (lim.stapm > cur.stapm) { cur.stapm = lim.stapm; chg = true; }
+    if (lim.fast > cur.fast) { cur.fast = lim.fast; chg = true; }
+    if (lim.slow > cur.slow) { cur.slow = lim.slow; chg = true; }
+    if (chg) {
+      std::lock_guard<std::mutex> lk(s_ryzenMutex);
+      s_recordedMaxLimits = cur;
+      std::error_code ec;
+      std::filesystem::create_directories(std::filesystem::path(ryzenMaxLimitFilePath()).parent_path(), ec);
+      if (std::ofstream f(ryzenMaxLimitFilePath()); f.is_open()) {
+        f << cur.stapm << " " << cur.fast << " " << cur.slow << "\n";
+      }
+    }
+  }
+
+  std::optional<RyzenLimits> queryCurrentRyzenLimits() {
+    RyzenLimits lim{};
+    auto res = sendDaemonCommand("ryzen get");
+    if (!res.empty() && res != "unknown" && res != "error") {
+      std::istringstream iss(res);
+      if (iss >> lim.stapm >> lim.fast >> lim.slow && lim.valid()) return lim;
+    }
+    auto out = process::runSync("ryzenadj -i");
+    if (out.exitCode == 0 && !out.out.empty()) {
+      std::istringstream stream(out.out);
+      std::string line;
+      while (std::getline(stream, line)) {
+        auto parseVal = [&](std::string_view key, double& dst) {
+          if (line.find(key) == std::string::npos) return;
+          auto b1 = line.find('|'), b2 = line.find('|', b1 + 1), b3 = line.find('|', b2 + 1);
+          if (b2 != std::string::npos && b3 != std::string::npos) {
+            try { dst = std::stod(StringUtils::trim(line.substr(b2 + 1, b3 - b2 - 1))); } catch (...) {}
+          }
+        };
+        parseVal("STAPM LIMIT", lim.stapm);
+        parseVal("PPT LIMIT FAST", lim.fast);
+        parseVal("PPT LIMIT SLOW", lim.slow);
+      }
+      if (lim.valid()) return lim;
+    }
+    return std::nullopt;
+  }
+
+  bool checkRyzenUnlocked() {
+    auto current = queryCurrentRyzenLimits();
+    if (!current.has_value()) {
+      return false;
+    }
+    auto maxRec = getRecordedMaxLimits();
+    if (!maxRec.valid()) {
+      if (current->stapm >= 70.0 && current->fast >= 70.0 && current->slow >= 45.0) {
+        recordMaxLimits(*current);
+        return true;
+      }
+      return false;
+    }
+    if (current->stapm > maxRec.stapm || current->fast > maxRec.fast || current->slow > maxRec.slow) {
+      recordMaxLimits(*current);
+      maxRec = getRecordedMaxLimits();
+    }
+    return current->isAtOrAbove(maxRec, 1.0);
+  }
+
+  bool getHyprForceRgbx() {
+    auto res = process::runSync("hyprctl repl 'return hl_force_rgbx'");
+    if (res.exitCode == 0 && !res.out.empty()) {
+      return StringUtils::trim(res.out) == "true";
+    }
+    return false;
+  }
+
+  bool getHyprAnimations() {
+    auto res = process::runSync("hyprctl getoption animations:enabled -j");
+    return (res.out.find("\"int\": 1") != std::string::npos || res.out.find("\"bool\": true") != std::string::npos);
+  }
+
+  bool getHyprDecorations() {
+    auto res = process::runSync("hyprctl getoption decoration:blur:enabled -j");
+    return (res.out.find("\"int\": 1") != std::string::npos || res.out.find("\"bool\": true") != std::string::npos);
+  }
+
