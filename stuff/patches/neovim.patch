     break;
 
   case VTERM_PROP_CURSORVISIBLE:
@@ -1741,6 +1751,10 @@ static int term_sb_push(int cols, const VTermScreenCell *cells, void *data)
     term->sb_pending++;
   }
 
+  VTermState *state = vterm_obtain_state(term->vt);
+  const VTermLineInfo *info = vterm_state_get_lineinfo(state, 0);
+  sbrow->continuation = info ? info->continuation : false;
+
   memcpy(sbrow->cells, cells, sizeof(cells[0]) * c);
   if (!term->synchronized_output) {
     set_put(ptr_t, &invalidated_terminals, term);
@@ -2259,6 +2273,14 @@ static bool send_mouse_event(Terminal *term, int c)
   }
 
   if (c == K_MOUSEUP || c == K_MOUSEDOWN || c == K_MOUSELEFT || c == K_MOUSERIGHT) {
+    if (term->in_altscreen && !term->forward_mouse) {
+      int key = (c == K_MOUSEUP) ? K_DOWN : (c == K_MOUSEDOWN) ? K_UP : (c == K_MOUSELEFT) ? K_LEFT : K_RIGHT;
+      for (int i = 0; i < 3; i++) {
+        terminal_send_key(term, key);
+      }
+      return false;
+    }
+
     win_T *save_curwin = curwin;
     // switch window/buffer to perform the scroll
     curwin = mouse_win;
@@ -2710,6 +2732,28 @@ static char *get_config_string(buf_T *buf, char *key)
   return NULL;
 }
 
+bool terminal_line_is_continuation(buf_T *buf, int linenr)
+{
+  if (!buf || !buf->terminal) {
+    return false;
+  }
+  Terminal *term = buf->terminal;
+  int row = linenr_to_row(term, linenr);
+  if (row < 0) {
+    int idx = -row - 1;
+    if (idx >= 0 && (size_t)idx < term->sb_current) {
+      return term->sb_buffer[idx]->continuation;
+    }
+  } else {
+    VTermState *state = vterm_obtain_state(term->vt);
+    const VTermLineInfo *info = vterm_state_get_lineinfo(state, row);
+    if (info) {
+      return info->continuation;
+    }
+  }
+  return false;
+}
+
 // }}}
 
