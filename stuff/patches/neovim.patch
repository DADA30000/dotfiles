 } ScrollbackLine;
 
@@ -1605,6 +1606,15 @@ static int term_settermprop(VTermProp prop, VTermValue *val, void *data)
   switch (prop) {
   case VTERM_PROP_ALTSCREEN:
     term->in_altscreen = val->boolean;
+    buf_T *alt_buf = handle_get_buffer(term->buf_handle);
+    if (alt_buf) {
+      Error err = ERROR_INIT;
+      dict_set_var(alt_buf->b_vars,
+                   STATIC_CSTR_AS_STRING("terminal_altscreen"),
