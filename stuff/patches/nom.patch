+urlToHost :: Set (Host WithContext) -> Text -> Maybe (Host WithContext)
+urlToHost knownHosts url =
+  case find (\h -> toText h `Text.isPrefixOf` url) (sortOn (negate . Text.length . toText) (toList knownHosts)) of
+    Just h -> Just h
+    Nothing ->
+      let (schema, suffix) = Text.breakOn "://" url
+      in if Text.null suffix
+           then Nothing
+           else
+             let hostPart = fst $ Text.breakOn "/" (Text.drop 3 suffix)
+             in if Text.null hostPart then Nothing else Just (Host (Just schema) Nothing hostPart)
