+  std::string generateCvtModeline(int hdisplay, int vdisplay, float vrefresh) {
+    int vsync = 10;
+    if (!(vdisplay % 3) && ((vdisplay * 4 / 3) == hdisplay))
+      vsync = 4;
+    else if (!(vdisplay % 9) && ((vdisplay * 16 / 9) == hdisplay))
+      vsync = 5;
+    else if (!(vdisplay % 10) && ((vdisplay * 16 / 10) == hdisplay))
+      vsync = 6;
+    else if (!(vdisplay % 4) && ((vdisplay * 5 / 4) == hdisplay))
+      vsync = 7;
+    else if (!(vdisplay % 9) && ((vdisplay * 15 / 9) == hdisplay))
+      vsync = 7;
+
+    double hperiod = (1000000.0 / vrefresh - 550.0) / (vdisplay + 3);
+    int vsync_and_back_porch = std::max(static_cast<int>(550.0 / hperiod) + 1, vsync + 6);
+    int vtotal = vdisplay + vsync_and_back_porch + 3;
+
+    double c_prime = (40.0 - 20.0) * 128.0 / 256.0 + 20.0;
+    double m_prime = 600.0 * 128.0 / 256.0;
+    double hblank_pct = std::max(20.0, c_prime - m_prime * hperiod / 1000.0);
+
+    int hblank = static_cast<int>(hdisplay * hblank_pct / (100.0 - hblank_pct));
+    hblank -= hblank % 16;
+    int htotal = hdisplay + hblank;
+    int hsync_end = hdisplay + hblank / 2;
+    int hsync_w = (htotal * 8) / 100;
+    hsync_w -= hsync_w % 8;
+    int hsync_start = hsync_end - hsync_w;
+
+    int vsync_start = vdisplay + 3;
+    int vsync_end = vsync_start + vsync;
+
+    int dot_clock = static_cast<int>(htotal * 1000.0 / hperiod);
+    dot_clock -= dot_clock % 250;
+    double pclk = dot_clock / 1000.0;
+
+    return std::format(
+        "modeline {:.2F} {} {} {} {} {} {} {} {} -hsync +vsync",
+        pclk, hdisplay, hsync_start, hsync_end, htotal,
+        vdisplay, vsync_start, vsync_end, vtotal
+    );
+  }
