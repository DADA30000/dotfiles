+#include <vector>
+
+class Flex;
+class Label;
+class Toggle;
+class Button;
+
+class VpnTab : public Tab {
+public:
+  VpnTab();
+
+  std::unique_ptr<Flex> create() override;
+  void onClose() override;
+
+protected:
+  void doLayout(Renderer& renderer, float contentWidth, float bodyHeight) override;
+  void doUpdate(Renderer& renderer) override;
+
