diff --git a/lib/build.rs b/lib/build.rs
new file mode 100644
index 0000000..fd1c35c
--- /dev/null
+++ b/lib/build.rs
@@ -0,0 +1,58 @@
+use std::path::PathBuf;
+use std::process::Command;
+
+fn get_pkg_dir(pkg: &str) -> Option<PathBuf> {
+    std::env::var(format!("{}_DIR", pkg.to_uppercase().replace('-', "_")))
+        .ok()
+        .map(PathBuf::from)
+        .or_else(|| {
+            Command::new("pkg-config")
+                .args(["--variable=pkgdatadir", pkg])
+                .output()
+                .ok()
+                .and_then(|out| {
+                    if out.status.success() {
+                        let s = String::from_utf8_lossy(&out.stdout).trim().to_string();
+                        (!s.is_empty()).then(|| PathBuf::from(s))
+                    } else {
+                        None
+                    }
+                })
+        })
+        .or_else(|| {
+            let p = PathBuf::from(format!("/usr/share/{pkg}"));
+            p.exists().then_some(p)
+        })
+}
+
+fn main() {
+    println!("cargo:rustc-link-lib=gbm");
+
+    let manifest_dir = PathBuf::from(std::env::var("CARGO_MANIFEST_DIR").unwrap());
+    let proto_dir = manifest_dir.join("protocols");
+    std::fs::create_dir_all(&proto_dir).unwrap();
+
+    let wp = get_pkg_dir("wayland-protocols").expect("wayland-protocols not found");
+    let hp = get_pkg_dir("hyprland-protocols")
+        .or_else(|| {
+            let sub = manifest_dir.join("hyprland-protocols");
+            sub.exists().then_some(sub)
+        })
+        .expect("hyprland-protocols not found");
+
+    let files = [
+        (wp.join("staging/ext-image-copy-capture/ext-image-copy-capture-v1.xml"), "ext-image-copy-capture-v1.xml"),
+        (wp.join("staging/ext-image-capture-source/ext-image-capture-source-v1.xml"), "ext-image-capture-source-v1.xml"),
+        (wp.join("staging/ext-foreign-toplevel-list/ext-foreign-toplevel-list-v1.xml"), "ext-foreign-toplevel-list-v1.xml"),
+        (wp.join("staging/ext-workspace/ext-workspace-v1.xml"), "ext-workspace-v1.xml"),
+        (wp.join("stable/linux-dmabuf/linux-dmabuf-v1.xml"), "linux-dmabuf-v1.xml"),
+        (hp.join("protocols/hyprland-workspace-image-capture-source-v1.xml"), "hyprland-workspace-image-capture-source-v1.xml"),
+    ];
+
+    for (src, name) in files {
+        let dst = proto_dir.join(name);
+        if !dst.exists() {
+            let _ = std::fs::copy(&src, &dst);
+        }
+    }
+}
