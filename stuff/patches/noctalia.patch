+    int hblank = (static_cast<int>(h * hblank_pct / (100.0 - hblank_pct)) / 16) * 16;
+    int htotal = h + hblank;
+    int hsync_end = h + hblank / 2;
+    int hsync_w = ((htotal * 8) / 100 / 8) * 8;
+    int pclk_khz = (static_cast<int>(htotal * 1000.0 / hperiod) / 250) * 250;
