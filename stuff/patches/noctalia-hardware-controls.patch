+  card->addChild(makeCardHeaderRow("Интерфейс", scale));
+
+  auto makeRow = [&](std::string_view label, std::unique_ptr<Node> ctrl) {
+    auto r = ui::row({.align = FlexAlign::Center, .gap = Style::spaceSm * scale, .minHeight = Style::controlHeightSm * scale});
+    r->addChild(ui::label({
+        .text = std::string(label), .fontSize = Style::fontSizeBody * scale,
+        .fontWeight = FontWeight::Bold, .color = colorSpecFromRole(ColorRole::OnSurface), .flexGrow = 1.0F
+    }));
+    r->addChild(std::move(ctrl));
+    return r;
+  };
+
+  card->addChild(makeRow("Анимации Hyprland", ui::toggle({
+      .out = &m_hyprAnimToggle, .checkedImmediate = getHyprAnimations(),
+      .toggleSize = ToggleSize::Medium, .scale = scale,
+      .onChange = [](bool chk) { (void)process::runAsync(std::format("hyprctl eval 'hl.config {{ animations = {{ enabled = {} }} }}'", chk ? 1 : 0)); },
+  })));
+
+  card->addChild(makeRow("Декорации Hyprland", ui::toggle({
+      .out = &m_hyprDecorToggle, .checkedImmediate = getHyprDecorations(),
+      .toggleSize = ToggleSize::Medium, .scale = scale,
+      .onChange = [](bool chk) { (void)process::runAsync(std::format("hyprctl eval 'hl.config {{ decoration = {{ blur = {{ enabled = {} }}, rounding = {} }} }}'", chk ? "true" : "false", chk ? 10 : 0)); },
+  })));
+
+  card->addChild(makeRow("Принудительная непрозрачность", ui::toggle({
+      .out = &m_forceOpaqueToggle, .checkedImmediate = getHyprForceRgbx(),
+      .toggleSize = ToggleSize::Medium, .scale = scale,
+      .onChange = [](bool chk) {
+        (void)process::runAsync(std::format(
+            "hyprctl eval 'hl.window_rule({{ name = \"force-rgbx-toggle\", match = {{ class = \".*\" }}, force_rgbx = {} }}); hl_force_rgbx = {}'",
+            chk ? "true" : "false", chk ? "true" : "false"
+        ));
+      },
+  })));
+  root.addChild(std::move(card));
+}
