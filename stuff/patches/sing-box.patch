diff -Naur a/route/rule/rule_item_outbound_selected.go b/route/rule/rule_item_outbound_selected.go
--- a/route/rule/rule_item_outbound_selected.go	1970-01-01 03:00:00.000000000 +0300
+++ b/route/rule/rule_item_outbound_selected.go	2026-10-23 22:38:39.792344032 +0300
@@ -0,0 +1,88 @@
+package rule
+
+import (
+	"context"
+	"strings"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/json/badjson"
+	"github.com/sagernet/sing/common/json/badoption"
+	"github.com/sagernet/sing/service"
+)
+
+var _ RuleItem = (*OutboundSelectedItem)(nil)
+
+type OutboundSelectedItem struct {
+	ctx             context.Context
+	outboundManager adapter.OutboundManager
+	selections      map[string][]string
+	description     string
+}
+
+func NewOutboundSelectedItem(ctx context.Context, selections *badjson.TypedMap[string, badoption.Listable[string]]) *OutboundSelectedItem {
+	item := &OutboundSelectedItem{
+		ctx:        ctx,
+		selections: make(map[string][]string, selections.Size()),
+	}
+	var descriptions []string
+	for _, entry := range selections.Entries() {
+		item.selections[entry.Key] = entry.Value
+		descriptions = append(descriptions, entry.Key+"="+strings.Join(entry.Value, ","))
+	}
+	item.description = "outbound_selected=[" + strings.Join(descriptions, " ") + "]"
+	return item
+}
+
+func (r *OutboundSelectedItem) Start() error {
+	r.outboundManager = service.FromContext[adapter.OutboundManager](r.ctx)
+	return nil
+}
+
+func (r *OutboundSelectedItem) Match(metadata *adapter.InboundContext) bool {
+	if r.outboundManager == nil {
+		r.outboundManager = service.FromContext[adapter.OutboundManager](r.ctx)
+		if r.outboundManager == nil {
+			return false
+		}
+	}
+	for groupTag, expectedTags := range r.selections {
+		outbound, loaded := r.outboundManager.Outbound(groupTag)
+		if !loaded {
+			return false
+		}
+		group, isGroup := outbound.(adapter.OutboundGroup)
+		if !isGroup {
+			return false
+		}
+		currentTag := group.Now()
+		realTag := currentTag
+		detour := outbound
+		for {
+			g, ok := detour.(adapter.OutboundGroup)
+			if !ok {
+				break
+			}
+			realTag = g.Now()
+			var ok2 bool
+			detour, ok2 = r.outboundManager.Outbound(realTag)
+			if !ok2 {
+				break
+			}
+		}
+		matched := false
+		for _, expected := range expectedTags {
+			if expected == currentTag || expected == realTag {
+				matched = true
+				break
+			}
+		}
+		if !matched {
+			return false
+		}
+	}
+	return true
+}
+
+func (r *OutboundSelectedItem) String() string {
+	return r.description
+}
