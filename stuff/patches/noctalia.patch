+  std::string apiGet(const std::string& path) {
+    auto res = process::runSync(std::vector<std::string>{"curl", "-s", "--max-time", "6", "http://127.0.0.1:9090" + path});
+    return res.exitCode == 0 ? res.out : std::string{};
+  }
+
+  bool apiPut(const std::string& path, const std::string& jsonPayload) {
+    auto res = process::runSync(std::vector<std::string>{
+        "curl", "-s", "--max-time", "2", "-X", "PUT", "http://127.0.0.1:9090" + path,
+        "-H", "Content-Type: application/json", "-d", jsonPayload
+    });
+    return res.exitCode == 0;
+  }
+
