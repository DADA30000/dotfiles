+void MotionService::setSpeed(float speed) { m_speed = std::clamp(speed, 0.01F, 10.0F); }
+
+void MotionService::setSpeed(AnimationKind kind, float speed) {
+  if (kind == AnimationKind::Default) {
+    setSpeed(speed);
+  } else {
+    m_speeds[kind] = std::clamp(speed, 0.01F, 10.0F);
+  }
+}
+
+float MotionService::speed(AnimationKind kind) const noexcept {
+  if (kind != AnimationKind::Default) {
+    const auto it = m_speeds.find(kind);
+    if (it != m_speeds.end()) {
+      return it->second;
+    }
+  }
+  return m_speed;
+}
