+
+namespace {
+
+  std::string apiGet(const std::string& path) {
+    auto res = process::runSync(std::format("curl -s --max-time 6 'http://127.0.0.1:9090{}'", path));
+    return res.exitCode == 0 ? res.out : std::string{};
+  }
+
+  bool apiPut(const std::string& path, const std::string& jsonPayload) {
+    auto res = process::runSync(std::format(
+        "curl -s --max-time 2 -X PUT 'http://127.0.0.1:9090{}' -H 'Content-Type: application/json' -d '{}'",
+        path, jsonPayload
+    ));
+    return res.exitCode == 0;
+  }
+
+} // namespace
+
+VpnTab::VpnTab() = default;
+
+std::unique_ptr<Flex> VpnTab::create() {
+  const float scale = contentScale();
+
+  auto tab = ui::column({
+      .out = &m_root,
+      .align = FlexAlign::Stretch,
+      .gap = Style::spaceMd * scale,
+  });
+
+  auto scroll = ui::scrollView({
+      .scrollbarVisible = true,
+      .flexGrow = 1.0F,
+      .configure = [](ScrollView& scrollView) {
+        scrollView.clearFill();
+        scrollView.clearBorder();
+      },
+  });
+
+  auto* content = scroll->content();
+  content->setDirection(FlexDirection::Vertical);
+  content->setAlign(FlexAlign::Stretch);
+  content->setGap(Style::spaceMd * scale);
+
+  // 1. Status Card
+  auto statusCard = ui::column({
+      .configure = [scale, opacity = panelCardOpacity()](Flex& section) {
+        applySectionCardStyle(section, scale, opacity);
+      },
+  });
+  m_statusCard = statusCard.get();
+
+  auto activeRow = ui::row(
+      {.align = FlexAlign::Center, .gap = Style::spaceSm * scale, .minHeight = Style::controlHeightSm * scale},
+      ui::glyph({
+          .glyph = "shield-check",
+          .glyphSize = Style::fontSizeTitle * scale,
+          .color = colorSpecFromRole(ColorRole::Primary),
+      }),
+      ui::label({
+          .text = "Активный узел:",
+          .fontSize = Style::fontSizeBody * scale,
+          .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+      }),
+      ui::label({
+          .out = &m_activeProxyLabel,
+          .text = "Загрузка...",
+          .fontSize = Style::fontSizeBody * scale,
+          .fontWeight = FontWeight::Bold,
+          .color = colorSpecFromRole(ColorRole::Primary),
+          .flexGrow = 1.0F,
+      })
+  );
+  statusCard->addChild(std::move(activeRow));
+
+  // Route unmatched traffic (final-toggle)
+  auto routeRow = ui::row(
+      {.align = FlexAlign::Center, .gap = Style::spaceSm * scale, .minHeight = Style::controlHeightSm * scale},
+      ui::column(
+          {.align = FlexAlign::Stretch, .flexGrow = 1.0F},
+          ui::label({
+              .text = "Весь остальной трафик",
+              .fontSize = Style::fontSizeBody * scale,
+              .fontWeight = FontWeight::Bold,
+              .color = colorSpecFromRole(ColorRole::OnSurface),
+          }),
+          ui::label({
+              .out = &m_finalStateLabel,
+              .text = "Режим: proxy",
+              .fontSize = Style::fontSizeCaption * scale,
+              .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+          })
+      ),
+      ui::toggle({
+          .out = &m_finalToggle,
+          .checkedImmediate = true,
+          .toggleSize = ToggleSize::Medium,
+          .scale = scale,
+          .onChange = [this](bool checked) { setFinalRoute(checked); },
+      })
+  );
+  statusCard->addChild(std::move(routeRow));
+  content->addChild(std::move(statusCard));
+
+  // 2. Nodes Card
+  auto nodesCard = ui::column({
+      .configure = [scale, opacity = panelCardOpacity()](Flex& section) {
+        applySectionCardStyle(section, scale, opacity);
+      },
+  });
+  m_nodesCard = nodesCard.get();
+
+  auto nodesList = ui::column({
+      .out = &m_nodesList,
+      .align = FlexAlign::Stretch,
+      .gap = Style::spaceSm * scale,
+  });
+  nodesCard->addChild(std::move(nodesList));
+
+  auto testBtnRow = ui::row(
+      {.align = FlexAlign::Center, .justify = FlexJustify::End},
+      ui::button({
+          .out = &m_testButton,
+          .text = i18n::tr("control-center.vpn.ping"),
+          .variant = ButtonVariant::Default,
+          .paddingV = Style::spaceXs * 0.8F * scale,
+          .paddingH = Style::spaceMd * scale,
+          .radius = 999.0F,
+          .onClick = [this]() { testAllLatencies(); },
+      })
+  );
+  nodesCard->addChild(std::move(testBtnRow));
+  content->addChild(std::move(nodesCard));
+
+  m_root->addChild(std::move(scroll));
+
+  fetchProxies();
+
+  return tab;
+}
+
+void VpnTab::onClose() {
+  m_root = nullptr;
+  m_statusCard = nullptr;
+  m_activeProxyLabel = nullptr;
+  m_finalToggle = nullptr;
+  m_finalStateLabel = nullptr;
+  m_nodesCard = nullptr;
+  m_nodesList = nullptr;
+  m_testButton = nullptr;
+}
+
+void VpnTab::doLayout(Renderer& renderer, float contentWidth, float bodyHeight) {
+  if (m_root == nullptr) {
+    return;
+  }
+  m_root->setSize(contentWidth, bodyHeight);
+  m_root->layout(renderer);
+}
+
+void VpnTab::doUpdate(Renderer& renderer) {
+  if (m_needsRebuild) {
+    m_needsRebuild = false;
+    rebuildNodeList();
+    if (m_root != nullptr) {
+      m_root->layout(renderer);
+    }
+  }
+}
+
+void VpnTab::fetchProxies() {
+  std::thread([this]() {
+    const std::string proxyJson = apiGet("/proxies/proxy");
+    const std::string finalJson = apiGet("/proxies/final-toggle");
+
+    std::string active;
+    std::vector<ProxyNode> nodes;
+    std::string finalMode = "direct";
+
+    try {
+      if (!proxyJson.empty()) {
+        auto root = nlohmann::json::parse(proxyJson);
+        active = root.value("now", "");
+        if (root.contains("all") && root["all"].is_array()) {
+          for (const auto& item : root["all"]) {
+            std::string name = item.get<std::string>();
+            nodes.push_back(ProxyNode{
+                .name = name,
+                .active = (name == active),
+                .delayMs = -1,
+            });
+          }
+        }
+      }
+      if (!finalJson.empty()) {
+        auto root = nlohmann::json::parse(finalJson);
+        finalMode = root.value("now", "direct");
+      }
+    } catch (...) {}
+
+    DeferredCall::callLater([this, active = std::move(active), finalMode = std::move(finalMode), nodes = std::move(nodes)]() mutable {
+      m_activeProxy = std::move(active);
+      m_finalMode = std::move(finalMode);
+      m_nodes = std::move(nodes);
+      rebuildNodeList();
+      PanelManager::instance().requestLayout();
+      PanelManager::instance().requestRedraw();
+    });
+  }).detach();
+}
+
+void VpnTab::selectProxy(const std::string& name) {
+  std::thread([this, name]() {
+    const std::string payload = std::format("{{\"name\": \"{}\"}}", name);
+    if (apiPut("/proxies/proxy", payload)) {
+      DeferredCall::callLater([this, name]() {
+        m_activeProxy = name;
+        for (auto& node : m_nodes) {
+          node.active = (node.name == name);
+        }
+        rebuildNodeList();
+        PanelManager::instance().refresh();
+      });
+    }
+  }).detach();
+}
+
+void VpnTab::setFinalRoute(bool toProxy) {
+  std::thread([this, toProxy]() {
+    const std::string target = toProxy ? "proxy" : "direct";
+    const std::string payload = std::format("{{\"name\": \"{}\"}}", target);
+    if (apiPut("/proxies/final-toggle", payload)) {
+      DeferredCall::callLater([this, target]() {
+        m_finalMode = target;
+        rebuildNodeList();
+        PanelManager::instance().requestLayout();
+        PanelManager::instance().requestRedraw();
+      });
+    }
+  }).detach();
+}
+
+void VpnTab::testAllLatencies() {
+  if (m_testButton != nullptr) {
+    m_testButton->setText("Тестирование...");
+    m_testButton->setHitTestVisible(false);
+  }
+
+  std::thread([this]() {
+    for (auto& node : m_nodes) {
+      const std::string path = std::format("/proxies/{}/delay?timeout=5000&url=http://www.gstatic.com/generate_204", node.name);
+      const std::string out = apiGet(path);
+      try {
+        if (!out.empty()) {
+          auto root = nlohmann::json::parse(out);
+          node.delayMs = root.value("delay", -1);
+        }
+      } catch (...) {
+        node.delayMs = -1;
+      }
+    }
+    DeferredCall::callLater([this]() {
+      rebuildNodeList();
+      if (m_testButton != nullptr) {
+        m_testButton->setText(i18n::tr("control-center.vpn.ping"));
+        m_testButton->setHitTestVisible(true);
+      }
+      PanelManager::instance().refresh();
+    });
+  }).detach();
+}
+
+void VpnTab::rebuildNodeList() {
+  const float scale = contentScale();
+
+  if (m_activeProxyLabel != nullptr) {
+    m_activeProxyLabel->setText(m_activeProxy.empty() ? "--" : m_activeProxy);
+  }
+
+  if (m_finalToggle != nullptr) {
+    m_finalToggle->setCheckedImmediate(m_finalMode == "proxy");
+  }
+  if (m_finalStateLabel != nullptr) {
+    m_finalStateLabel->setText(m_finalMode == "proxy" ? "Режим: proxy (через VPN)" : "Режим: direct (напрямую)");
+  }
+
+  if (m_nodesList == nullptr) {
+    return;
+  }
+
+  while (!m_nodesList->children().empty()) {
+    m_nodesList->removeChild(m_nodesList->children().front().get());
+  }
+
+  for (const auto& node : m_nodes) {
+    const bool isActive = (node.name == m_activeProxy);
+    auto row = ui::button({
+        .variant = isActive ? ButtonVariant::Primary : ButtonVariant::Default,
+        .paddingV = Style::spaceSm * scale,
+        .paddingH = Style::spaceMd * scale,
+        .radius = Style::scaledRadiusMd(scale),
+        .onClick = [this, name = node.name]() { selectProxy(name); },
+    });
+    row->setDirection(FlexDirection::Horizontal);
+    row->setAlign(FlexAlign::Center);
+    row->setGap(Style::spaceSm * scale);
+    row->setMinHeight(Style::controlHeightSm * scale);
+
+    row->addChild(
+        ui::glyph({
+            .glyph = isActive ? "shield-check" : "shield-lock",
+            .glyphSize = Style::baseGlyphSize * scale,
+            .color = colorSpecFromRole(isActive ? ColorRole::OnPrimary : ColorRole::OnSurface),
+        })
+    );
+
+    row->addChild(
+        ui::label({
+            .text = node.name,
+            .fontSize = Style::fontSizeBody * scale,
+            .fontWeight = isActive ? FontWeight::Bold : FontWeight::Normal,
+            .color = colorSpecFromRole(isActive ? ColorRole::OnPrimary : ColorRole::OnSurface),
+            .flexGrow = 1.0F,
+        })
+    );
+
+    std::string delayText = "--";
+    if (node.delayMs > 0) {
+      delayText = std::format("{} ms", node.delayMs);
+    }
+    row->addChild(
+        ui::label({
+            .text = delayText,
+            .fontSize = Style::fontSizeCaption * scale,
+            .fontWeight = FontWeight::Medium,
+            .color = colorSpecFromRole(isActive ? ColorRole::OnPrimary : ColorRole::Tertiary),
+        })
+    );
+
+    m_nodesList->addChild(std::move(row));
+  }
+}
