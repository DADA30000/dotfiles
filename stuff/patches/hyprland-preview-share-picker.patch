diff --git a/lib/src/workspace.rs b/lib/src/workspace.rs
new file mode 100644
index 0000000..5eaab41
--- /dev/null
+++ b/lib/src/workspace.rs
@@ -0,0 +1,46 @@
+#[derive(Clone, Debug)]
+pub struct Workspace {
+    pub id: u64,
+    pub name: String,
+    pub outputs: Vec<String>,
+}
+
+fn take_len_prefixed(s: &str) -> Option<(String, &str)> {
+    let (len_str, rest) = s.split_once(':')?;
+    let len = len_str.parse::<usize>().ok()?;
+    if rest.len() < len || !rest.is_char_boundary(len) {
+        return None;
+    }
+    Some((rest[..len].to_string(), &rest[len..]))
+}
+
+impl Workspace {
+    /// Parse `XDPH_WORKSPACE_SHARING_LIST_V3`
+    /// (`<id>[HN>]<name_len>:<name>[HM>]<out_count>:<out_len>:<out>...[HE>]`).
+    pub fn parse_list(list: &str) -> Vec<Workspace> {
+        let mut workspaces = Vec::new();
+        let mut s = list;
+        while !s.is_empty() {
+            let Some((id_str, rest)) = s.split_once("[HN>]") else { break };
+            let Ok(id) = id_str.parse::<u64>() else { break };
+            if id == 0 {
+                break;
+            }
+            let Some((name, rest)) = take_len_prefixed(rest) else { break };
+            let Some(rest) = rest.strip_prefix("[HM>]") else { break };
+            let Some((count_str, mut rest)) = rest.split_once(':') else { break };
+            let Ok(count) = count_str.parse::<usize>() else { break };
+
+            let mut outputs = Vec::with_capacity(count);
+            for _ in 0..count {
+                let Some((out, next)) = take_len_prefixed(rest) else { return workspaces };
+                outputs.push(out);
+                rest = next;
+            }
+            let Some(next) = rest.strip_prefix("[HE>]") else { break };
+            s = next;
+            workspaces.push(Workspace { id, name, outputs });
+        }
+        workspaces
+    }
+}
